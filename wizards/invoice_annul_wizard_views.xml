<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_invoice_annul_wizard_form" model="ir.ui.view">
        <field name="name">l10n_do_ncf.invoice.annul.wizard.form</field>
        <field name="model">l10n_do_ncf.invoice.annul.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular Factura">
                <group>
                    <group string="Información de la Factura">
                        <field name="move_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="ncf_number"/>
                        <field name="partner_name"/>
                        <field name="amount_total"/>
                    </group>
                </group>
                <separator string="Opciones de Anulación"/>
                <group>
                    <field name="action_type" widget="radio"/>
                </group>
                <group>
                    <field name="annul_reason" placeholder="Indique el motivo de la anulación..."/>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>Nota:</strong>
                    <ul>
                        <li><b>Anular Directamente:</b> La factura se cancela y el NCF queda ocupado. Se reportará como "Anulado" en el 607.</li>
                        <li><b>Crear Nota de Crédito:</b> Se genera un documento B04 que reversa fiscalmente la factura original.</li>
                    </ul>
                </div>
                <footer>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_invoice_annul_wizard" model="ir.actions.act_window">
        <field name="name">Anular Factura</field>
        <field name="res_model">l10n_do_ncf.invoice.annul.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>