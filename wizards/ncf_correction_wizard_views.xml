<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================= -->
    <!-- WIZARD CORRECCIÓN RNC (B02 → B01)            -->
    <!-- ============================================= -->

    <record id="view_ncf_rnc_correction_wizard_form" model="ir.ui.view">
        <field name="name">l10n_do_ncf.rnc.correction.wizard.form</field>
        <field name="model">l10n_do_ncf.rnc.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Corrección RNC - B02 a B01">
                <div class="alert alert-info" role="alert">
                    <strong>📋 Este wizard le ayuda a corregir facturas B02 cuando el cliente obtiene RNC.</strong>
                    <p class="mt-2 mb-0">
                        Se generará automáticamente:<br/>
                        1. Nota de Crédito (B04) a la factura B02 original<br/>
                        2. Nueva factura B01 con el RNC del cliente
                    </p>
                </div>

                <group>
                    <group string="Factura a Corregir">
                        <field name="invoice_id" options="{'no_create': True}"/>
                        <field name="invoice_amount"/>
                    </group>
                    <group string="Cliente">
                        <field name="partner_id" readonly="1"/>
                        <field name="partner_vat"/>
                        <div class="alert alert-success" role="status" invisible="not partner_vat">
                            <strong>✓ Cliente tiene RNC</strong>
                        </div>
                        <div class="alert alert-danger" role="alert" invisible="partner_vat">
                            <strong>✗ Cliente sin RNC - Asigne primero</strong>
                        </div>
                    </group>
                </group>

                <group>
                    <field name="credit_note_reason"/>
                    <field name="notes"/>
                </group>

                <footer>
                    <button name="action_validate" string="Validar" type="object" class="btn-secondary"/>
                    <button name="action_process" string="Procesar Corrección" type="object" class="btn-primary"
                            invisible="not partner_vat"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ncf_rnc_correction_wizard" model="ir.actions.act_window">
        <field name="name">Corregir Factura por RNC</field>
        <field name="res_model">l10n_do_ncf.rnc.correction.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================= -->
    <!-- WIZARD CORRECCIÓN RETENCIÓN                  -->
    <!-- ============================================= -->

    <record id="view_ncf_retention_correction_wizard_form" model="ir.ui.view">
        <field name="name">l10n_do_ncf.retention.correction.wizard.form</field>
        <field name="model">l10n_do_ncf.retention.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Corrección de Retención">
                <div class="alert alert-warning" role="alert">
                    <strong>⚠️ Corrección de retención mal aplicada</strong>
                    <p class="mt-2 mb-0">
                        Use este wizard cuando detecte un error en retenciones ya reportadas.<br/>
                        La corrección se aplicará en el próximo período fiscal.
                    </p>
                </div>

                <group>
                    <group string="Documento Original">
                        <field name="move_id" options="{'no_create': True}"/>
                        <field name="original_isr"/>
                        <field name="original_itbis"/>
                    </group>
                    <group string="Corrección">
                        <field name="correction_type"/>
                        <field name="correction_amount"/>
                        <field name="apply_next_period"/>
                    </group>
                </group>

                <group string="Motivo de la Corrección">
                    <field name="reason" nolabel="1" placeholder="Explique el motivo de la corrección..."/>
                </group>

                <footer>
                    <button name="action_process" string="Registrar Corrección" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ncf_retention_correction_wizard" model="ir.actions.act_window">
        <field name="name">Corregir Retención</field>
        <field name="res_model">l10n_do_ncf.retention.correction.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================= -->
    <!-- WIZARD NC MULTI-PERÍODO 607                  -->
    <!-- ============================================= -->

    <record id="view_ncf_607_multiperiod_wizard_form" model="ir.ui.view">
        <field name="name">l10n_do_ncf.607.multiperiod.wizard.form</field>
        <field name="model">l10n_do_ncf.607.multiperiod.wizard</field>
        <field name="arch" type="xml">
            <form string="NC Multi-período 607">
                <div class="alert alert-info" role="alert" invisible="not is_different_period">
                    <strong>📋 Nota de Crédito de período diferente</strong>
                    <p class="mt-2 mb-0">
                        La NC y la factura original son de períodos fiscales diferentes.<br/>
                        Esto es normal y permitido por DGII.
                    </p>
                </div>

                <group>
                    <group string="Nota de Crédito">
                        <field name="credit_note_id" options="{'no_create': True}"/>
                        <field name="credit_period"/>
                    </group>
                    <group string="Factura Original">
                        <field name="origin_invoice_id" readonly="1"/>
                        <field name="origin_period"/>
                    </group>
                </group>

                <group>
                    <field name="is_different_period" invisible="1"/>
                    <div class="alert alert-success" role="status" invisible="is_different_period">
                        <strong>✓ Mismo período fiscal</strong> - Se reportan juntas en 607.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_different_period">
                        <strong>⚠️ Períodos diferentes</strong> - La NC va al 607 del período <field name="credit_period" readonly="1" class="fw-bold"/>
                    </div>
                </group>

                <footer>
                    <button name="action_confirm_period" string="Confirmar" type="object" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- MENÚS                                        -->
    <!-- ============================================= -->

    <menuitem id="menu_ncf_corrections"
              name="Correcciones Fiscales"
              parent="account.menu_finance_configuration"
              sequence="95"/>

    <menuitem id="menu_ncf_rnc_correction"
              name="Corregir B02 → B01"
              parent="menu_ncf_corrections"
              action="action_ncf_rnc_correction_wizard"
              sequence="10"/>

    <menuitem id="menu_ncf_retention_correction"
              name="Corregir Retención"
              parent="menu_ncf_corrections"
              action="action_ncf_retention_correction_wizard"
              sequence="20"/>

</odoo>