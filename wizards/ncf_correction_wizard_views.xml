    <!-- ============================================= -->
    <!-- CONCILIACIÃ“N FISCAL                          -->
    <!-- ============================================= -->

    <record id="view_fiscal_reconciliation_form" model="ir.ui.view">
        <field name="name">l10n_do_ncf.fiscal.reconciliation.form</field>
        <field name="model">l10n_do_ncf.fiscal.reconciliation</field>
        <field name="arch" type="xml">
            <form string="ConciliaciÃ³n Fiscal 606/607">
                <header>
                    <button name="action_calculate" string="Calcular" type="object" 
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_reset" string="Reiniciar" type="object" 
                            class="btn-secondary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>ConciliaciÃ³n Fiscal</h1>
                    </div>

                    <group>
                        <group string="ParÃ¡metros">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="report_type" widget="radio"/>
                        </group>
                    </group>

                    <notebook invisible="state != 'done'">
                        <!-- TAB 606 -->
                        <page string="Compras (606)" name="tab_606" invisible="report_type == '607'">
                            <group>
                                <group string="Totales 606">
                                    <field name="total_606_compras"/>
                                    <field name="total_606_itbis_facturado"/>
                                    <field name="total_606_itbis_adelantar"/>
                                    <field name="total_606_isr_retenido"/>
                                </group>
                                <group string="Totales Contables">
                                    <field name="total_contable_compras"/>
                                    <field name="total_contable_itbis_compras"/>
                                </group>
                            </group>
                            <group string="Diferencias">
                                <field name="diff_606_total" class="text-danger fw-bold"/>
                                <field name="diff_606_itbis" class="text-danger fw-bold"/>
                            </group>
                        </page>

                        <!-- TAB 607 -->
                        <page string="Ventas (607)" name="tab_607" invisible="report_type == '606'">
                            <group>
                                <group string="Totales 607">
                                    <field name="total_607_ventas"/>
                                    <field name="total_607_itbis"/>
                                </group>
                                <group string="Totales Contables">
                                    <field name="total_contable_ventas"/>
                                    <field name="total_contable_itbis_ventas"/>
                                </group>
                            </group>
                            <group string="Diferencias">
                                <field name="diff_607_total" class="text-danger fw-bold"/>
                                <field name="diff_607_itbis" class="text-danger fw-bold"/>
                            </group>
                        </page>

                        <!-- TAB DISCREPANCIAS -->
                        <page string="Discrepancias" name="tab_discrepancies" 
                              badge="discrepancy_ids">
                            <field name="discrepancy_ids">
                                <list decoration-danger="severity == 'high'" 
                                      decoration-warning="severity == 'medium'"
                                      create="false" edit="false">
                                    <field name="report_type" widget="badge"/>
                                    <field name="move_name"/>
                                    <field name="partner_name"/>
                                    <field name="discrepancy_type"/>
                                    <field name="fiscal_amount" sum="Total Fiscal"/>
                                    <field name="accounting_amount" sum="Total Contable"/>
                                    <field name="difference" sum="Total Diferencia"/>
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity == 'high'"
                                           decoration-warning="severity == 'medium'"
                                           decoration-success="severity == 'low'"/>
                                    <button name="action_open_document" type="object" 
                                            icon="fa-external-link" title="Ver documento"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

