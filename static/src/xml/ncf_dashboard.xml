<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Panel NCF / Panel e-CF.

        Una sola plantilla para los dos modos:
          - state.ecf_active = false  -> Dashboard NCF (papel, licencia). Es lo
            que ve un cliente que solo tiene l10n_do_ncf.
          - state.ecf_active = true   -> Panel e-CF (datos de la plataforma). Lo
            activa l10n_do_ecf_newplain; su patch JS añade `platform` y los
            métodos del listado "e-CF de la plataforma".

        Estructura de scroll: la cabecera queda fija y solo .ncfd-body hace
        scroll (ver ncf_styles.css, sección LAYOUT).
    -->
    <t t-name="l10n_do_ncf.Dashboard">
        <div class="o_action ncfd" t-att-class="{'ncfd--ecf': state.ecf_active}">

            <!-- ================= CABECERA (fija) ================= -->
            <header class="ncfd-header">
                <div class="ncfd-header__main">
                    <div class="ncfd-header__icon">
                        <i t-att-class="state.ecf_active ? 'fa fa-bolt' : 'fa fa-file-text-o'"/>
                    </div>
                    <div class="ncfd-header__text">
                        <h1 class="ncfd-title">
                            <t t-if="state.ecf_active">Panel e-CF</t>
                            <t t-else="">Dashboard NCF</t>
                        </h1>
                        <div class="ncfd-subtitle">
                            <t t-if="state.ecf_active">
                                <span>Facturación electrónica</span>
                                <span t-if="state.provider_label" class="ncfd-pill is-info" t-esc="state.provider_label"/>
                                <span t-if="state.dgii_env_label" class="ncfd-pill"
                                      t-att-class="envClass(state.dgii_env)"
                                      title="Ambiente DGII que informa la plataforma"
                                      t-esc="state.dgii_env_label"/>
                            </t>
                            <t t-else="">
                                <span>Comprobantes fiscales</span>
                                <span t-if="state.current_month" class="ncfd-subtitle__sep">·</span>
                                <span t-if="state.current_month" t-esc="state.current_month"/>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="ncfd-header__actions">
                    <button class="btn btn-secondary" t-on-click="refresh" t-att-disabled="state.loading">
                        <i class="fa fa-refresh" t-att-class="{'fa-spin': state.loading}"/>
                        <span class="ncfd-hide-sm">Actualizar</span>
                    </button>
                    <button t-if="state.ecf_active and state.can_load_sequence"
                            class="btn btn-primary" t-on-click="openLoadSequence">
                        <i class="fa fa-plus"/>
                        <span class="ncfd-hide-sm">Cargar secuencia e-CF</span>
                    </button>
                </div>
            </header>

            <!-- ================= CUERPO (hace scroll) ================= -->
            <div class="ncfd-body">
                <div class="ncfd-container">

                    <!-- Plataforma no disponible -->
                    <div t-if="state.ecf_active and !state.api_available" class="ncfd-banner is-warning" role="status">
                        <i class="fa fa-plug"/>
                        <div>
                            <strong>Plataforma e-CF no disponible.</strong>
                            <span t-esc="state.api_message"/>
                        </div>
                    </div>

                    <!-- Avisos: una sola tarjeta compacta -->
                    <section t-if="state.alerts and state.alerts.length" class="ncfd-card ncfd-alerts">
                        <div class="ncfd-alerts__head">
                            <i class="fa fa-exclamation-triangle"/>
                            <span>Avisos</span>
                            <span class="ncfd-count" t-esc="state.alerts.length"/>
                        </div>
                        <ul class="ncfd-alerts__list">
                            <li t-foreach="alertGroups()" t-as="group" t-key="group.key"
                                class="ncfd-alert" t-att-class="'is-' + group.type">
                                <span class="ncfd-dot"/>
                                <strong t-esc="group.title"/>
                                <span class="ncfd-alert__msgs">
                                    <t t-foreach="group.messages" t-as="msg" t-key="msg_index">
                                        <span class="ncfd-alert__msg" t-esc="msg"/>
                                    </t>
                                </span>
                            </li>
                        </ul>
                    </section>

                    <!-- ================= INDICADORES ================= -->
                    <div class="ncfd-kpis">
                        <t t-if="state.ecf_active">
                            <div class="ncfd-card ncfd-kpi">
                                <div class="ncfd-kpi__top">
                                    <span class="ncfd-kpi__label">Aceptados</span>
                                    <span class="ncfd-kpi__icon is-success"><i class="fa fa-check"/></span>
                                </div>
                                <div class="ncfd-kpi__value" t-esc="fmtInt(state.accepted_month)"/>
                                <div class="ncfd-kpi__hint">Este mes</div>
                            </div>
                            <div class="ncfd-card ncfd-kpi">
                                <div class="ncfd-kpi__top">
                                    <span class="ncfd-kpi__label">Rechazados</span>
                                    <span class="ncfd-kpi__icon is-danger"><i class="fa fa-times"/></span>
                                </div>
                                <div class="ncfd-kpi__value" t-esc="fmtInt(state.rejected_month)"/>
                                <div class="ncfd-kpi__hint">Este mes</div>
                            </div>
                            <div class="ncfd-card ncfd-kpi">
                                <div class="ncfd-kpi__top">
                                    <span class="ncfd-kpi__label">En proceso</span>
                                    <span class="ncfd-kpi__icon is-warning"><i class="fa fa-hourglass-half"/></span>
                                </div>
                                <div class="ncfd-kpi__value" t-esc="fmtInt(state.pending_month)"/>
                                <div class="ncfd-kpi__hint">Esperando respuesta de la DGII</div>
                            </div>
                            <div class="ncfd-card ncfd-kpi">
                                <div class="ncfd-kpi__top">
                                    <span class="ncfd-kpi__label">Plan</span>
                                    <span class="ncfd-kpi__icon is-info"><i class="fa fa-credit-card"/></span>
                                </div>
                                <t t-if="state.plan and state.plan.has_plan">
                                    <div class="ncfd-kpi__value is-text" t-esc="state.plan.name"/>
                                    <div class="ncfd-meter">
                                        <div class="ncfd-meter__bar" t-att-class="quotaTone(state.plan.percentage)"
                                             t-attf-style="width: #{pct(state.plan.percentage)}%"/>
                                    </div>
                                    <div class="ncfd-kpi__hint">
                                        <t t-esc="fmtInt(state.plan.used)"/> de <t t-esc="fmtInt(state.plan.quota)"/> usadas
                                        <t t-if="state.plan.days_remaining !== ''">· <t t-esc="state.plan.days_remaining"/> días</t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="ncfd-kpi__value is-text"
                                         t-att-class="{'is-danger-text': state.plan and state.plan.billing_required}">Sin plan activo</div>
                                    <div class="ncfd-kpi__hint" t-esc="(state.plan and state.plan.message) || 'La plataforma no informó el plan.'"/>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="ncfd-card ncfd-kpi">
                                <div class="ncfd-kpi__top">
                                    <span class="ncfd-kpi__label">Facturas</span>
                                    <span class="ncfd-kpi__icon is-info"><i class="fa fa-file-text-o"/></span>
                                </div>
                                <div class="ncfd-kpi__value" t-esc="fmtInt(state.invoices_month)"/>
                                <div class="ncfd-kpi__hint">
                                    <t t-if="state.pos_orders_month">
                                        <t t-esc="fmtInt(state.invoices_only)"/> facturas + <t t-esc="fmtInt(state.pos_orders_month)"/> POS
                                    </t>
                                    <t t-else="">Este mes</t>
                                </div>
                            </div>
                            <div class="ncfd-card ncfd-kpi">
                                <div class="ncfd-kpi__top">
                                    <span class="ncfd-kpi__label">Compras</span>
                                    <span class="ncfd-kpi__icon is-success"><i class="fa fa-shopping-cart"/></span>
                                </div>
                                <div class="ncfd-kpi__value" t-esc="fmtInt(state.purchases_month)"/>
                                <div class="ncfd-kpi__hint">Este mes</div>
                            </div>
                            <div class="ncfd-card ncfd-kpi">
                                <div class="ncfd-kpi__top">
                                    <span class="ncfd-kpi__label">Anulados</span>
                                    <span class="ncfd-kpi__icon is-warning"><i class="fa fa-ban"/></span>
                                </div>
                                <div class="ncfd-kpi__value" t-esc="fmtInt(state.cancelled_month)"/>
                                <div class="ncfd-kpi__hint">Este mes</div>
                            </div>
                            <div class="ncfd-card ncfd-kpi">
                                <div class="ncfd-kpi__top">
                                    <span class="ncfd-kpi__label">Licencia</span>
                                    <span class="ncfd-kpi__icon"
                                          t-att-class="state.license and state.license.is_valid ? 'is-success' : 'is-danger'">
                                        <i class="fa fa-key"/>
                                    </span>
                                </div>
                                <t t-if="state.license and state.license.is_valid">
                                    <div class="ncfd-kpi__value is-text is-success-text">Activa</div>
                                    <div class="ncfd-kpi__hint"><t t-esc="state.license.days_remaining"/> días restantes</div>
                                </t>
                                <t t-else="">
                                    <div class="ncfd-kpi__value is-text is-danger-text">Inactiva</div>
                                    <div class="ncfd-kpi__hint">
                                        <a href="#" t-on-click.prevent="openLicense">Configurar licencia</a>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>

                    <!-- ================= SECUENCIAS (e-CF o NCF) ================= -->
                    <section class="ncfd-card">
                        <div class="ncfd-card__head">
                            <div>
                                <h2 class="ncfd-card__title">
                                    <t t-if="state.ecf_active">Comprobantes electrónicos (e-CF)</t>
                                    <t t-else="">Secuencias NCF activas</t>
                                </h2>
                                <p class="ncfd-card__sub">
                                    <t t-if="state.ecf_active">Rangos autorizados por la DGII, leídos de la plataforma</t>
                                    <t t-else="">Secuencias locales en uso</t>
                                </p>
                            </div>
                            <button t-if="!state.ecf_active" class="btn btn-sm btn-secondary" t-on-click="openSequences">
                                Ver todas
                            </button>
                        </div>

                        <div t-if="state.sequences and state.sequences.length" class="ncfd-table-wrap">
                            <table class="ncfd-table">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th t-if="state.ecf_active">Rango</th>
                                        <th t-if="state.ecf_active">Próximo</th>
                                        <th class="ncfd-col-usage">Usados</th>
                                        <th class="text-end">Disponibles</th>
                                        <th>Vence</th>
                                        <th t-if="state.ecf_active">Estado</th>
                                        <th t-if="state.ecf_active and state.can_load_sequence" class="text-end"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.sequences" t-as="seq" t-key="seq.id"
                                        t-att-class="{'is-dimmed': isDimmed(seq)}">
                                        <td>
                                            <div class="ncfd-type">
                                                <span class="ncfd-code" t-esc="seq.prefix"/>
                                                <span class="ncfd-type__name" t-esc="seq.name"/>
                                            </div>
                                        </td>
                                        <td t-if="state.ecf_active">
                                            <span class="ncfd-mono ncfd-muted" t-esc="seq.range_label || '—'"/>
                                        </td>
                                        <td t-if="state.ecf_active">
                                            <span class="ncfd-mono" t-esc="seq.next_encf || '—'"/>
                                        </td>
                                        <td>
                                            <div class="ncfd-usage">
                                                <div class="ncfd-meter">
                                                    <div class="ncfd-meter__bar" t-att-class="stockTone(seq)"
                                                         t-attf-style="width: #{usedPct(seq)}%"/>
                                                </div>
                                                <span class="ncfd-usage__txt">
                                                    <t t-esc="fmtInt(usedCount(seq))"/> / <t t-esc="fmtInt(seq.total)"/>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <span class="ncfd-num" t-att-class="availClass(seq)" t-esc="fmtInt(seq.available)"/>
                                        </td>
                                        <td class="ncfd-nowrap" t-esc="seq.expiration"/>
                                        <td t-if="state.ecf_active">
                                            <span class="ncfd-pill" t-att-class="seqStatusClass(seq.status)"
                                                  t-esc="seq.status_label || seq.status"/>
                                        </td>
                                        <td t-if="state.ecf_active and state.can_load_sequence" class="text-end">
                                            <button t-if="seq.can_deactivate" class="ncfd-ghost-btn is-danger"
                                                    title="Desactivar rango"
                                                    t-on-click="() => this.deactivateSequence(seq)">
                                                <i class="fa fa-ban"/> Desactivar
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div t-else="" class="ncfd-empty">
                            <i class="fa fa-list-ol"/>
                            <t t-if="state.ecf_active">
                                <p>No hay rangos e-CF registrados en la plataforma.</p>
                                <button t-if="state.can_load_sequence" class="btn btn-primary btn-sm" t-on-click="openLoadSequence">
                                    Cargar secuencia e-CF
                                </button>
                            </t>
                            <t t-else="">
                                <p>No hay secuencias NCF activas.</p>
                                <button class="btn btn-primary btn-sm" t-on-click="openSequences">Crear secuencia</button>
                            </t>
                        </div>
                    </section>

                    <!-- ================= PAPEL (solo e-CF con diario de papel o POS) ================= -->
                    <section t-if="state.ecf_active and state.has_paper" class="ncfd-card">
                        <div class="ncfd-card__head">
                            <div>
                                <h2 class="ncfd-card__title">Comprobantes en papel (NCF serie B)</h2>
                                <p class="ncfd-card__sub">Diarios de papel y punto de venta</p>
                            </div>
                            <button class="btn btn-sm btn-secondary" t-on-click="openSequences">Ver todas</button>
                        </div>
                        <div t-if="state.paper_sequences and state.paper_sequences.length" class="ncfd-table-wrap">
                            <table class="ncfd-table">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th class="ncfd-col-usage">Usados</th>
                                        <th class="text-end">Disponibles</th>
                                        <th>Vence</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.paper_sequences" t-as="pseq" t-key="pseq.id">
                                        <td>
                                            <div class="ncfd-type">
                                                <span class="ncfd-code" t-esc="pseq.prefix"/>
                                                <span class="ncfd-type__name" t-esc="pseq.name"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="ncfd-usage">
                                                <div class="ncfd-meter">
                                                    <div class="ncfd-meter__bar" t-att-class="stockTone(pseq)"
                                                         t-attf-style="width: #{usedPct(pseq)}%"/>
                                                </div>
                                                <span class="ncfd-usage__txt">
                                                    <t t-esc="fmtInt(usedCount(pseq))"/> / <t t-esc="fmtInt(pseq.total)"/>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <span class="ncfd-num" t-att-class="availClass(pseq)" t-esc="fmtInt(pseq.available)"/>
                                        </td>
                                        <td class="ncfd-nowrap" t-esc="pseq.expiration"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div t-else="" class="ncfd-empty">
                            <i class="fa fa-file-o"/>
                            <p>No hay secuencias en papel (serie B) activas.</p>
                            <button class="btn btn-primary btn-sm" t-on-click="openSequences">Crear secuencia en papel</button>
                        </div>
                    </section>

                    <!-- ================= POR TIPO + ÚLTIMOS ================= -->
                    <div class="ncfd-split">
                        <section class="ncfd-card">
                            <div class="ncfd-card__head">
                                <div>
                                    <h2 class="ncfd-card__title">
                                        <t t-if="state.ecf_active">e-CF por tipo</t>
                                        <t t-else="">NCF por tipo</t>
                                    </h2>
                                    <p class="ncfd-card__sub">Este mes</p>
                                </div>
                            </div>
                            <ul t-if="state.ncf_by_type and state.ncf_by_type.length" class="ncfd-bytype">
                                <li t-foreach="state.ncf_by_type" t-as="item" t-key="item.prefix">
                                    <div class="ncfd-bytype__row">
                                        <span class="ncfd-code" t-esc="item.prefix"/>
                                        <span class="ncfd-bytype__name" t-esc="item.name"/>
                                        <span class="ncfd-bytype__count" t-esc="fmtInt(item.count)"/>
                                    </div>
                                    <div class="ncfd-meter is-thin">
                                        <div class="ncfd-meter__bar is-accent" t-attf-style="width: #{typeShare(item)}%"/>
                                    </div>
                                    <div t-if="item.pos_count" class="ncfd-bytype__detail">
                                        <t t-esc="fmtInt(item.invoice_count)"/> facturas + <t t-esc="fmtInt(item.pos_count)"/> POS
                                    </div>
                                </li>
                            </ul>
                            <div t-else="" class="ncfd-empty is-compact">
                                <p>
                                    <t t-if="state.ecf_active">Sin e-CF emitidos este mes.</t>
                                    <t t-else="">Sin NCF generados este mes.</t>
                                </p>
                            </div>
                        </section>

                        <section class="ncfd-card">
                            <div class="ncfd-card__head">
                                <div>
                                    <h2 class="ncfd-card__title">
                                        <t t-if="state.ecf_active">Últimos e-CF</t>
                                        <t t-else="">Últimos NCF generados</t>
                                    </h2>
                                    <p class="ncfd-card__sub">Los 10 más recientes</p>
                                </div>
                                <span class="ncfd-pill is-neutral">Total histórico: <t t-esc="fmtInt(state.total_ncf_generated)"/></span>
                            </div>
                            <div t-if="state.recent_ncf and state.recent_ncf.length" class="ncfd-table-wrap">
                                <table class="ncfd-table">
                                    <thead>
                                        <tr>
                                            <th><t t-if="state.ecf_active">e-NCF</t><t t-else="">NCF</t></th>
                                            <th>Cliente</th>
                                            <th class="text-end">Monto</th>
                                            <th>Fecha</th>
                                            <th><t t-if="state.ecf_active">Estado</t><t t-else="">Origen</t></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.recent_ncf" t-as="ncf" t-key="ncf_index"
                                            class="is-clickable" t-on-click="() => this.openDocument(ncf)">
                                            <td><span class="ncfd-mono ncfd-link" t-esc="ncf.ncf"/></td>
                                            <td>
                                                <div class="ncfd-party">
                                                    <span class="ncfd-party__name" t-esc="ncf.partner" t-att-title="ncf.partner"/>
                                                    <span t-if="ncf.partner_vat" class="ncfd-party__id" t-esc="ncf.partner_vat"/>
                                                </div>
                                            </td>
                                            <td class="text-end ncfd-num">
                                                <t t-esc="ncf.currency || 'RD$'"/> <t t-esc="fmtMoney(ncf.amount)"/>
                                            </td>
                                            <td class="ncfd-nowrap" t-esc="ncf.date"/>
                                            <td class="ncfd-nowrap">
                                                <t t-if="state.ecf_active">
                                                    <span class="ncfd-pill" t-att-class="invoiceStatusClass(ncf.state)"
                                                          t-esc="ncf.status_label || ncf.state"/>
                                                    <span t-if="ncf.in_odoo === false" class="ncfd-pill is-neutral"
                                                          title="No existe en Odoo, solo en la plataforma">Solo plataforma</span>
                                                </t>
                                                <t t-else="">
                                                    <span t-if="ncf.type === 'pos'" class="ncfd-pill is-success">POS</span>
                                                    <span t-elif="ncf.move_type === 'out_refund'" class="ncfd-pill is-warning">Nota de crédito</span>
                                                    <span t-else="" class="ncfd-pill is-info">Factura</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div t-else="" class="ncfd-empty is-compact">
                                <p>
                                    <t t-if="state.ecf_active">No hay e-CF emitidos aún.</t>
                                    <t t-else="">No hay NCF generados aún.</t>
                                </p>
                            </div>
                        </section>
                    </div>

                    <!-- ================= e-CF DE LA PLATAFORMA (conector) ================= -->
                    <section t-if="state.ecf_active and platform" class="ncfd-card">
                        <div class="ncfd-card__head">
                            <div>
                                <h2 class="ncfd-card__title">e-CF de la plataforma</h2>
                                <p class="ncfd-card__sub">Todo lo emitido para esta empresa, aunque no exista en Odoo</p>
                            </div>
                            <span t-if="platform.total" class="ncfd-pill is-neutral">
                                <t t-esc="fmtInt(platform.total)"/> comprobantes
                            </span>
                        </div>

                        <div class="ncfd-filters">
                            <div class="ncfd-field">
                                <label>e-NCF</label>
                                <input type="text" class="form-control" placeholder="E31…"
                                       t-model="platform.filters.encf"
                                       t-on-keydown="(ev) => ev.key === 'Enter' and this.applyPlatformFilters()"/>
                            </div>
                            <div class="ncfd-field">
                                <label>RNC comprador</label>
                                <input type="text" class="form-control" placeholder="RNC o cédula"
                                       t-model="platform.filters.buyerRnc"
                                       t-on-keydown="(ev) => ev.key === 'Enter' and this.applyPlatformFilters()"/>
                            </div>
                            <div class="ncfd-field">
                                <label>Tipo</label>
                                <select class="form-select" t-model="platform.filters.ecfType">
                                    <option value="">Todos</option>
                                    <option value="E31">E31 · Crédito fiscal</option>
                                    <option value="E32">E32 · Consumo</option>
                                    <option value="E33">E33 · Nota de débito</option>
                                    <option value="E34">E34 · Nota de crédito</option>
                                    <option value="E41">E41 · Compras</option>
                                    <option value="E43">E43 · Gastos menores</option>
                                    <option value="E44">E44 · Regímenes especiales</option>
                                    <option value="E45">E45 · Gubernamental</option>
                                    <option value="E46">E46 · Exportaciones</option>
                                    <option value="E47">E47 · Pagos al exterior</option>
                                </select>
                            </div>
                            <div class="ncfd-field">
                                <label>Estado</label>
                                <select class="form-select" t-model="platform.filters.status">
                                    <option value="">Todos</option>
                                    <option value="ACCEPTED">Aceptado</option>
                                    <option value="CONDITIONAL">Aceptado con obs.</option>
                                    <option value="REJECTED">Rechazado</option>
                                    <option value="PROCESSING">Procesando</option>
                                    <option value="QUEUED">En cola</option>
                                    <option value="CONTINGENCY">Contingencia</option>
                                    <option value="ERROR">Error</option>
                                    <option value="VOIDED">Anulado</option>
                                </select>
                            </div>
                            <div class="ncfd-field">
                                <label>Desde</label>
                                <input type="date" class="form-control" t-model="platform.filters.dateFrom"/>
                            </div>
                            <div class="ncfd-field">
                                <label>Hasta</label>
                                <input type="date" class="form-control" t-model="platform.filters.dateTo"/>
                            </div>
                            <div class="ncfd-filters__actions">
                                <button class="btn btn-primary" t-on-click="applyPlatformFilters">
                                    <i class="fa fa-search"/> Buscar
                                </button>
                                <button class="btn btn-secondary" t-on-click="clearPlatformFilters">Limpiar</button>
                            </div>
                        </div>

                        <div t-if="!platform.api_available" class="ncfd-banner is-warning is-inset" role="status">
                            <i class="fa fa-plug"/>
                            <div>
                                <strong>Plataforma e-CF no disponible.</strong>
                                <span t-esc="platform.api_message"/>
                            </div>
                        </div>

                        <div t-if="platform.rows.length" class="ncfd-table-wrap" t-att-class="{'is-loading': platform.loading}">
                            <table class="ncfd-table">
                                <thead>
                                    <tr>
                                        <th>e-NCF</th>
                                        <th>Comprador</th>
                                        <th>Tipo</th>
                                        <th>Estado</th>
                                        <th class="text-end">Monto</th>
                                        <th>Fecha</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="platform.rows" t-as="row" t-key="row.platform_id || row_index">
                                        <td><span class="ncfd-mono" t-esc="row.encf"/></td>
                                        <td>
                                            <div class="ncfd-party">
                                                <span class="ncfd-party__name" t-esc="row.buyer" t-att-title="row.buyer"/>
                                                <span t-if="row.buyer_rnc" class="ncfd-party__id" t-esc="row.buyer_rnc"/>
                                            </div>
                                        </td>
                                        <td><span class="ncfd-code" t-esc="row.ecf_type" t-att-title="row.type_label"/></td>
                                        <td>
                                            <span class="ncfd-pill" t-att-class="invoiceStatusClass(row.status)" t-esc="row.status_label"/>
                                        </td>
                                        <td class="text-end ncfd-num">RD$ <t t-esc="fmtMoney(row.amount)"/></td>
                                        <td class="ncfd-nowrap" t-esc="row.date"/>
                                        <td class="text-end ncfd-nowrap">
                                            <div class="ncfd-row-actions">
                                                <button t-if="row.in_odoo" class="ncfd-ghost-btn is-primary"
                                                        title="Abrir la factura en Odoo"
                                                        t-on-click="() => this.openPlatformMove(row)">
                                                    <i class="fa fa-external-link"/> Odoo
                                                </button>
                                                <span t-else="" class="ncfd-pill is-neutral" title="No existe en Odoo">Solo plataforma</span>
                                                <a class="ncfd-ghost-btn" t-att-href="platformDownloadUrl(row, 'xml')"
                                                   title="Descargar XML"><i class="fa fa-code"/> XML</a>
                                                <a class="ncfd-ghost-btn" t-att-href="platformDownloadUrl(row, 'pdf')"
                                                   title="Descargar PDF"><i class="fa fa-file-pdf-o"/> PDF</a>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div t-elif="platform.loading" class="ncfd-empty is-compact">
                            <p><i class="fa fa-circle-o-notch fa-spin"/> Cargando…</p>
                        </div>
                        <div t-elif="platform.api_available" class="ncfd-empty is-compact">
                            <p>No hay e-CF que coincidan con el filtro.</p>
                        </div>

                        <div t-if="platform.total_pages > 1" class="ncfd-pager">
                            <span class="ncfd-muted">
                                Página <t t-esc="platform.page"/> de <t t-esc="platform.total_pages"/>
                            </span>
                            <div class="ncfd-pager__btns">
                                <button class="btn btn-secondary btn-sm" t-att-disabled="platform.page lte 1"
                                        t-on-click="platformPrevPage">
                                    <i class="fa fa-chevron-left"/> Anterior
                                </button>
                                <button class="btn btn-secondary btn-sm" t-att-disabled="platform.page gte platform.total_pages"
                                        t-on-click="platformNextPage">
                                    Siguiente <i class="fa fa-chevron-right"/>
                                </button>
                            </div>
                        </div>
                    </section>

                    <!-- ================= ACCESOS RÁPIDOS ================= -->
                    <section class="ncfd-card">
                        <div class="ncfd-card__head">
                            <div><h2 class="ncfd-card__title">Accesos rápidos</h2></div>
                        </div>
                        <div class="ncfd-tiles">
                            <button class="ncfd-tile" t-on-click="openInvoices">
                                <span class="ncfd-tile__icon is-info"><i class="fa fa-file-text-o"/></span>
                                <span class="ncfd-tile__text"><strong>Facturas</strong><small>Facturas de cliente</small></span>
                            </button>
                            <button class="ncfd-tile" t-on-click="openPurchases">
                                <span class="ncfd-tile__icon is-success"><i class="fa fa-shopping-cart"/></span>
                                <span class="ncfd-tile__text"><strong>Compras</strong><small>Facturas de proveedor</small></span>
                            </button>
                            <button class="ncfd-tile" t-on-click="openReports">
                                <span class="ncfd-tile__icon is-warning"><i class="fa fa-bar-chart"/></span>
                                <span class="ncfd-tile__text"><strong>Reportes DGII</strong><small>606 · 607 · 608</small></span>
                            </button>
                            <button t-if="!state.ecf_active or state.has_paper" class="ncfd-tile" t-on-click="openSequences">
                                <span class="ncfd-tile__icon is-neutral"><i class="fa fa-list-ol"/></span>
                                <span class="ncfd-tile__text">
                                    <strong><t t-if="state.ecf_active">Secuencias (papel)</t><t t-else="">Secuencias</t></strong>
                                    <small>NCF serie B</small>
                                </span>
                            </button>
                            <button t-if="!state.ecf_active or state.has_paper" class="ncfd-tile" t-on-click="openTypes">
                                <span class="ncfd-tile__icon is-neutral"><i class="fa fa-cog"/></span>
                                <span class="ncfd-tile__text">
                                    <strong><t t-if="state.ecf_active">Tipos NCF (papel)</t><t t-else="">Tipos NCF</t></strong>
                                    <small>Catálogo de comprobantes</small>
                                </span>
                            </button>
                            <button t-if="!state.ecf_active" class="ncfd-tile" t-on-click="openLicense">
                                <span class="ncfd-tile__icon is-neutral"><i class="fa fa-key"/></span>
                                <span class="ncfd-tile__text"><strong>Licencia</strong><small>Activación del módulo</small></span>
                            </button>
                        </div>
                    </section>

                </div>
            </div>
        </div>
    </t>

</templates>
