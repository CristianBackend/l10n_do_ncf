<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Ticket del POS con el comprobante fiscal (Odoo 16).

        DIFERENCIA CON LA 19: allí el recibo se arma con componentes
        (ReceiptHeader, paymentLines, formatCurrency...) y los datos salen de
        la propia orden. En Odoo 16 la plantilla es OrderReceipt y lee el
        objeto "receipt" que devuelve Order.export_for_printing()
        (point_of_sale/static/src/js/models.js:2711), que es donde
        pos_ncf_order.js añade los campos del comprobante. El encabezado de 16
        ya trae razón social, dirección y RNC del emisor, así que aquí solo se
        añade lo que falta para República Dominicana.

        owl="1" es obligatorio en 16: sin él la plantilla va al motor QWeb2
        antiguo.
    -->
    <t t-name="OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">

        <!-- Emisor: fecha de emisión y referencia del ticket (para buscar el
             pedido en una devolución). Solo en República Dominicana. -->
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="inside">
            <t t-if="receipt.l10n_do_is_do">
                <div t-if="receipt.l10n_do_issue_date">
                    Fecha Emisión: <t t-esc="receipt.l10n_do_issue_date"/>
                </div>
                <div t-if="receipt.l10n_do_ticket_ref" class="l10n-do-ticket-ref">
                    Ticket: <t t-esc="receipt.l10n_do_ticket_ref"/>
                </div>
            </t>
        </xpath>

        <!-- Comprobante fiscal: lo que exige la DGII en el ticket. -->
        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <div t-if="receipt.l10n_do_ncf_number" class="l10n-do-ncf pos-receipt-center-align">
                <div>--------------------------------</div>
                <div class="l10n-do-ncf__number">
                    <strong>NCF: <t t-esc="receipt.l10n_do_ncf_number"/></strong>
                </div>
                <div t-if="receipt.l10n_do_ncf_type_name" class="l10n-do-ncf__type">
                    <t t-esc="receipt.l10n_do_ncf_type_name"/>
                </div>
                <div t-if="receipt.l10n_do_partner_vat" class="l10n-do-ncf__vat">
                    RNC/Cédula: <t t-esc="receipt.l10n_do_partner_vat"/>
                </div>
            </div>
        </xpath>

        <!-- El QR de "pide tu factura" del portal de Odoo no va en el ticket
             en RD: el comprobante es el NCF (papel) o el e-CF, con su QR. -->
        <xpath expr="//img[@id='posqrcode']/.." position="attributes">
            <attribute name="t-if">receipt.pos_qr_code and !receipt.l10n_do_is_do</attribute>
        </xpath>

    </t>

</templates>
