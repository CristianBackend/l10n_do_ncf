<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================= -->
        <!-- GRUPO: Usuario NCF                           -->
        <!-- Puede ver y usar NCF en facturas             -->
        <!-- ============================================= -->
        <record id="group_ncf_user" model="res.groups">
            <field name="name">NCF - Usuario</field>
            <field name="comment">Puede ver secuencias NCF, usar NCF en facturas y generar reportes DGII básicos.</field>
        </record>

        <!-- ============================================= -->
        <!-- GRUPO: Administrador NCF                     -->
        <!-- Puede configurar todo el módulo NCF          -->
        <!-- ============================================= -->
        <record id="group_ncf_manager" model="res.groups">
            <field name="name">NCF - Administrador</field>
            <field name="implied_ids" eval="[(4, ref('group_ncf_user'))]"/>
            <field name="comment">Puede crear y configurar secuencias NCF, tipos de NCF, licencias y todas las configuraciones del módulo.</field>
        </record>

        <!-- ============================================= -->
        <!-- ASIGNACIÓN AUTOMÁTICA DE GRUPOS              -->
        <!-- Todos los usuarios internos → NCF Usuario    -->
        <!-- Usuarios con acceso contable → NCF Admin     -->
        <!-- ============================================= -->
        
        <!-- Todos los usuarios internos obtienen NCF Usuario automáticamente -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_ncf_user'))]"/>
        </record>

        <!-- Usuarios con permisos de facturación obtienen NCF Admin automáticamente -->
        <record id="account.group_account_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_ncf_manager'))]"/>
        </record>

    </data>
</odoo>