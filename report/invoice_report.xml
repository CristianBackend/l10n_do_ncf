<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================= -->
    <!-- ACCIONES PARA MENÚS NCF                      -->
    <!-- ============================================= -->

    <!-- Acción: Facturas con NCF -->
    <record id="action_ncf_invoices" model="ir.actions.act_window">
        <field name="name">Facturas con NCF</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('l10n_do_ncf_number', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay facturas con NCF
            </p>
            <p>Las facturas confirmadas generarán NCF automáticamente.</p>
        </field>
    </record>

    <!-- Acción: Compras con NCF -->
    <record id="action_ncf_bills" model="ir.actions.act_window">
        <field name="name">Compras con NCF</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('l10n_do_vendor_ncf', '!=', False)]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay compras con NCF registrado
            </p>
            <p>Registre el NCF del proveedor en cada factura de compra.</p>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- VISTA DE FORMULARIO                          -->
    <!-- ============================================= -->

    <record id="view_move_form_ncf" model="ir.ui.view">
        <field name="name">account.move.form.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <!-- ========================================= -->
            <!-- BANNER NCF PARA DOCUMENTOS CONFIRMADOS   -->
            <!-- ========================================= -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <!-- Banner NCF visible solo cuando hay NCF generado -->
                <div class="alert alert-success text-center py-2 px-3 mb-3" role="status"
                     style="font-size: 1.1em; border-radius: 8px;"
                     invisible="move_type not in ('out_invoice', 'out_refund') or not l10n_do_ncf_number">
                    <div class="d-flex justify-content-center align-items-center gap-4">
                        <span>
                            <strong>NCF:</strong>
                            <span class="fs-5 fw-bold" style="color: #155724;">
                                <field name="l10n_do_ncf_number" readonly="1" nolabel="1" class="d-inline"/>
                            </span>
                        </span>
                        <span class="text-muted">|</span>
                        <span>
                            <strong>Tipo:</strong>
                            <field name="l10n_do_ncf_type_display" nolabel="1" class="d-inline"/>
                        </span>
                        <!-- Badge de estado fiscal -->
                        <span class="badge bg-success ms-2"
                              invisible="l10n_do_fiscal_status != 'valid'">
                            Válido
                        </span>
                        <span class="badge bg-warning ms-2"
                              invisible="l10n_do_fiscal_status != 'credited'">
                            Con NC
                        </span>
                        <span class="badge bg-danger ms-2"
                              invisible="l10n_do_fiscal_status != 'annulled'">
                            Anulado
                        </span>
                    </div>
                </div>

                <!-- Campo oculto para estado fiscal (usado en badges) -->
                <field name="l10n_do_fiscal_status" invisible="1"/>
            </xpath>

            <!-- ========================================= -->
            <!-- NOTA DE DÉBITO DESDE LA FACTURA          -->
            <!-- ========================================= -->
            <!-- Si account_debit_note está instalado se usan su botón y su botón
                 inteligente (las notas salen igual como B03/E33). -->
            <xpath expr="//button[@name='action_reverse']" position="after">
                <field name="l10n_do_can_debit_note" invisible="1"/>
                <field name="l10n_do_std_debit_note" invisible="1"/>
                <button name="action_l10n_do_debit_note" string="Nota de débito" type="object"
                        groups="account.group_account_invoice"
                        invisible="not l10n_do_can_debit_note or l10n_do_std_debit_note"
                        help="Crea una nota de débito enlazada a esta factura, con su cliente y su comprobante."/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_l10n_do_view_debit_notes" type="object" class="oe_stat_button"
                        icon="fa-plus-square-o"
                        invisible="l10n_do_debit_note_count == 0 or l10n_do_std_debit_note">
                    <field name="l10n_do_debit_note_count" widget="statinfo" string="Notas de débito"/>
                </button>
            </xpath>

            <!-- ========================================= -->
            <!-- CAMPOS NCF - BLOQUE UNIFICADO            -->
            <!-- ========================================= -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <!-- Checkbox Requiere NCF -->
                <field name="l10n_do_ncf_required"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state == 'posted' or l10n_do_ncf_number"/>

                <!-- Tipo de Comprobante para FACTURAS (B01, B02, B14, B15, B16) -->
                <field name="l10n_do_ncf_type_id" invisible="1"/>
                <field name="l10n_do_ncf_type_display"
                       string="Comprobante"
                       invisible="move_type != 'out_invoice' or not l10n_do_ncf_required"
                       help="Tipo de comprobante fiscal según DGII (automático)"/>

                <!-- Tipo de Comprobante para NOTAS DE CRÉDITO (siempre B04, readonly) -->
                <field name="l10n_do_ncf_type_display"
                       string="Comprobante"
                       invisible="move_type != 'out_refund' or not l10n_do_ncf_required"
                       help="Las Notas de Crédito siempre usan B04 según DGII"/>

                <!-- Factura Origen (solo NC) -->
                <field name="l10n_do_origin_move_id"
                       string="Factura Origen"
                       invisible="move_type != 'out_refund'"
                       required="move_type == 'out_refund' and l10n_do_ncf_required and state != 'posted'"
                       readonly="state == 'posted' or l10n_do_ncf_number"
                       options="{'no_create': True}"
                       help="Seleccione la factura original que desea afectar con esta Nota de Crédito"/>

                <!-- NCF Afectado (solo NC) -->
                <field name="l10n_do_ncf_origin"
                       string="NCF Afectado"
                       invisible="move_type != 'out_refund'"
                       readonly="state == 'posted' or l10n_do_ncf_number"
                       placeholder="B0100000001"
                       help="NCF de la factura original. Este NCF NO se reutiliza, la NC genera un nuevo NCF según DGII."/>

                <!-- Motivo NC (solo NC, obligatorio) -->
                <field name="l10n_do_credit_note_reason"
                       string="Motivo"
                       invisible="move_type != 'out_refund'"
                       required="move_type == 'out_refund' and l10n_do_ncf_required"
                       readonly="state == 'posted' or l10n_do_ncf_number"
                       help="Motivo de la Nota de Crédito según clasificación DGII"/>
            </xpath>

            <!-- ========================================= -->
            <!-- CAMPOS PARA FACTURAS DE COMPRA           -->
            <!-- ========================================= -->
            <xpath expr="//field[@name='ref']" position="after">
                <!-- Tipo de compra: de él sale el tipo de comprobante (E41/E43/E47
                     o el del proveedor). Se elige solo según el proveedor. -->
                <field name="l10n_do_fiscal_type" invisible="1"/>
                <field name="l10n_do_purchase_kind" string="Tipo de compra"
                       invisible="move_type not in ('in_invoice', 'in_refund') or l10n_do_is_vendor_debit_note"
                       readonly="state != 'draft' or l10n_do_ncf_number"
                       required="move_type in ('in_invoice', 'in_refund') and state == 'draft' and not l10n_do_is_vendor_debit_note"/>
                <field name="l10n_do_is_vendor_debit_note" invisible="1"/>

                <!-- NCF del Proveedor: solo cuando el comprobante lo da él -->
                <label for="l10n_do_vendor_ncf" string="NCF Proveedor"
                       invisible="move_type not in ('in_invoice', 'in_refund') or l10n_do_purchase_kind != 'vendor'"/>
                <div class="d-flex align-items-center"
                     invisible="move_type not in ('in_invoice', 'in_refund') or l10n_do_purchase_kind != 'vendor'">
                    <field name="l10n_do_vendor_ncf"
                           placeholder="B0100000001 o E310000000001"
                           class="fw-bold oe_inline"
                           help="NCF tradicional (11 chars) o e-CF (13 chars)"/>
                    <field name="l10n_do_vendor_ncf_validated" invisible="1"/>
                    <field name="l10n_do_vendor_ncf_validation_source" invisible="1"/>

                    <!-- Botón Validar (solo si hay NCF y NO está validado) -->
                    <button name="action_validate_vendor_ncf" type="object"
                            string="Validar" class="btn-secondary ms-2"
                            invisible="not l10n_do_vendor_ncf or l10n_do_vendor_ncf_validated"/>

                    <!-- Badge de validación -->
                    <span class="badge bg-success ms-2"
                          invisible="not l10n_do_vendor_ncf_validated">
                        ✓ Validado
                    </span>
                </div>

                <!-- Tipo de Gasto (para reporte 606) -->
                <field name="l10n_do_expense_type"
                       string="Tipo Gasto"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       help="Clasificación de gasto para reporte 606 DGII"/>
            </xpath>

            <!-- ========================================= -->
            <!-- PESTAÑA RETENCIONES                      -->
            <!-- ========================================= -->
            <xpath expr="//page[@name='other_info']" position="before">
                <page string="Retenciones" name="retentions_page"
                      invisible="move_type not in ('in_invoice', 'in_refund')">

                    <group>
                        <group string="Retenciones Aplicadas">
                            <field name="l10n_do_total_isr_retention" string="Retención ISR" readonly="1"/>
                            <field name="l10n_do_total_itbis_retention" string="Retención ITBIS" readonly="1"/>
                        </group>
                        <group string="Resumen">
                            <field name="l10n_do_gross_total" string="Total Factura" readonly="1"/>
                            <field name="l10n_do_amount_to_pay" string="Monto a Pagar" readonly="1"
                                   class="fw-bold text-primary"/>
                        </group>
                    </group>
                    <!-- Una sola fuente: los impuestos de retención de las líneas
                         (los que generan asiento). Aquí solo se muestran. -->
                    <field name="l10n_do_retention_legacy" invisible="1"/>
                    <field name="l10n_do_retention_line_ids" nolabel="1" readonly="1"
                           invisible="l10n_do_retention_legacy">
                        <list create="0" delete="0" no_open="1">
                            <field name="tax_line_id" string="Impuesto de retención"/>
                            <field name="account_id" string="Cuenta"/>
                            <field name="tax_base_amount" string="Base"/>
                            <field name="amount_currency" string="Monto (en el asiento)" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="company_currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <p class="text-muted mt-2" invisible="l10n_do_retention_legacy">
                        Las retenciones se ponen como impuesto de retención en las líneas de la factura
                        (por ejemplo "-100% ITBIS" o la de ISR). Así entran en el asiento, reducen lo que
                        se le paga al proveedor y salen en el 606, el IR-17 y el e-CF.
                    </p>
                    <!-- Retenciones escritas en la pestaña: las de una factura anterior
                         (de solo lectura) o las de un borrador por corregir (se borran). -->
                    <div invisible="not l10n_do_retention_legacy and not l10n_do_retention_check">
                        <separator string="Retenciones registradas en la pestaña"/>
                        <p class="text-muted" invisible="not l10n_do_retention_legacy">
                            Factura confirmada antes de que las retenciones salieran de los impuestos: sus
                            reportes conservan estas retenciones.
                        </p>
                        <field name="l10n_do_retention_ids" nolabel="1"
                               readonly="state != 'draft' or l10n_do_retention_legacy">
                            <list create="0" editable="bottom">
                                <field name="retention_type_id" readonly="1"/>
                                <field name="tax_id" readonly="1" optional="hide"/>
                                <field name="base_amount" readonly="1"/>
                                <field name="rate" readonly="1"/>
                                <field name="retention_amount" readonly="1" sum="Total"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </div>
                    <p class="text-muted" invisible="l10n_do_purchase_kind != 'minor_expense'">
                        Un gasto menor no lleva retenciones.
                    </p>
                </page>
            </xpath>

            <!-- ========================================= -->
            <!-- INFORMACIÓN FISCAL EN OTRA INFO          -->
            <!-- ========================================= -->
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Información Fiscal RD" name="fiscal_rd_group"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <group>
                        <field name="l10n_do_purchase_kind" string="Tipo de compra"
                               invisible="move_type not in ('in_invoice', 'in_refund')" readonly="1"/>
                        <field name="l10n_do_fiscal_status" string="Estado Fiscal" readonly="1"
                               invisible="move_type not in ('out_invoice', 'out_refund')"/>
                    </group>
                    <group>
                        <field name="l10n_do_ncf_seq_id" string="Secuencia" readonly="1"
                               invisible="not l10n_do_ncf_number"/>
                        <!-- Vencimiento con alerta visual usando context_today() -->
                        <field name="l10n_do_ncf_expiration" string="Vencimiento NCF" readonly="1"
                               invisible="not l10n_do_ncf_seq_id"
                               decoration-danger="l10n_do_ncf_expiration and l10n_do_ncf_expiration &lt; context_today()"
                               decoration-warning="l10n_do_ncf_expiration and l10n_do_ncf_expiration &gt;= context_today() and l10n_do_ncf_expiration &lt; (context_today() + 30)"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

    <!-- ============================================= -->
    <!-- VISTAS DE LISTA                              -->
    <!-- ============================================= -->

    <!-- ============================================= -->
    <!-- FILTROS DE BÚSQUEDA                          -->
    <!-- ============================================= -->

    <record id="view_account_move_search_ncf" model="ir.ui.view">
        <field name="name">account.move.search.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <!-- Campos de búsqueda -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_do_ncf_number" string="NCF"
                       filter_domain="[('l10n_do_ncf_number', 'ilike', self)]"/>
                <field name="l10n_do_vendor_ncf" string="NCF Proveedor"
                       filter_domain="[('l10n_do_vendor_ncf', 'ilike', self)]"/>
                <field name="l10n_do_ncf_type_id" string="Tipo NCF"/>
            </xpath>

            <!-- Filtros predefinidos -->
            <xpath expr="//filter[@name='posted']" position="after">
                <separator/>
                <filter name="has_ncf" string="Con NCF"
                        domain="[('l10n_do_ncf_number', '!=', False)]"/>
                <filter name="no_ncf" string="Sin NCF"
                        domain="[('l10n_do_ncf_number', '=', False), ('move_type', 'in', ('out_invoice', 'out_refund'))]"/>
                <separator/>
                <filter name="type_b01" string="Crédito Fiscal (B01)"
                        domain="[('l10n_do_ncf_type_id.code', '=', '01')]"/>
                <filter name="type_b02" string="Consumo (B02)"
                        domain="[('l10n_do_ncf_type_id.code', '=', '02')]"/>
                <filter name="type_b04" string="Nota de Crédito (B04)"
                        domain="[('l10n_do_ncf_type_id.code', '=', '04')]"/>
                <separator/>
                <filter name="fiscal_valid" string="Estado: Válido"
                        domain="[('l10n_do_fiscal_status', '=', 'valid')]"/>
                <filter name="fiscal_credited" string="Estado: Con NC"
                        domain="[('l10n_do_fiscal_status', '=', 'credited')]"/>
                <filter name="fiscal_annulled" string="Estado: Anulado"
                        domain="[('l10n_do_fiscal_status', '=', 'annulled')]"/>
            </xpath>

            <!-- Agrupadores -->
            <xpath expr="//group" position="inside">
                <filter name="group_ncf_type" string="Tipo NCF"
                        context="{'group_by': 'l10n_do_ncf_type_id'}"/>
                <filter name="group_fiscal_status" string="Estado Fiscal"
                        context="{'group_by': 'l10n_do_fiscal_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>