<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_invoice_document_ncf" inherit_id="account.report_invoice_document">

        <!-- Agregar NCF al inicio del documento -->
        <xpath expr="//div[@class='page']" position="inside">
            <t t-if="o.l10n_do_ncf_number and o.move_type in ('out_invoice', 'out_refund')">
                <div class="row" style="margin-top: -20px; margin-bottom: 20px;">
                    <div class="col-12">
                        <table class="table table-sm table-bordered" style="background-color: #f8f9fa;">
                            <tr>
                                <td style="width: 15%;"><strong>NCF:</strong></td>
                                <td style="width: 35%; font-size: 1.2em; font-weight: bold;">
                                    <span t-field="o.l10n_do_ncf_number"/>
                                </td>
                                <td style="width: 20%;"><strong>Valido hasta:</strong></td>
                                <td style="width: 30%;">
                                    <span t-if="o.l10n_do_ncf_seq_id.expiration_date" t-field="o.l10n_do_ncf_seq_id.expiration_date"/>
                                    <span t-else="">N/A</span>
                                </td>
                            </tr>
                            <tr t-if="o.l10n_do_ncf_origin">
                                <td><strong>NCF Afectado:</strong></td>
                                <td colspan="3"><span t-field="o.l10n_do_ncf_origin"/></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </xpath>

    </template>

</odoo>
