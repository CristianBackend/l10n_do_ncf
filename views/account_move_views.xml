<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================= -->
    <!-- FACTURA CLIENTE - FORMULARIO                 -->
    <!-- ============================================= -->

    <record id="view_move_form_ncf" model="ir.ui.view">
        <field name="name">account.move.form.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- NCF Banner superior - Anclaje seguro -->
            <xpath expr="//sheet" position="before">
                <!-- Banner NCF Ventas -->
                <div class="alert alert-success text-center mb-3" role="alert"
                     attrs="{'invisible': ['|', ('l10n_do_ncf_number', '=', False), ('move_type', 'not in', ('out_invoice', 'out_refund'))]}">
                    <div class="d-flex justify-content-center align-items-center">
                        <span class="me-2">NCF:</span>
                        <span class="fs-3 fw-bold"><field name="l10n_do_ncf_number" readonly="1"/></span>
                        <field name="l10n_do_fiscal_status" widget="badge" class="ms-3"
                               decoration-success="l10n_do_fiscal_status == 'valid'"
                               decoration-warning="l10n_do_fiscal_status == 'partial_credit'"
                               decoration-danger="l10n_do_fiscal_status in ('annulled', 'rejected')"
                               decoration-info="l10n_do_fiscal_status in ('credited', 'debited')"/>
                    </div>
                </div>

                <!-- Banner NCF Proveedor -->
                <div class="alert alert-info text-center mb-3" role="status"
                     attrs="{'invisible': ['|', ('l10n_do_vendor_ncf', '=', False), ('move_type', 'not in', ('in_invoice', 'in_refund'))]}">
                    <span class="me-2">NCF Proveedor:</span>
                    <span class="fs-4 fw-bold"><field name="l10n_do_vendor_ncf" readonly="1"/></span>
                    <span class="badge bg-success ms-2" attrs="{'invisible': [('l10n_do_vendor_ncf_validated', '=', False)]}">✓ Validado</span>
                </div>

                <!-- Banner BLOQUEADO si reportado -->
                <div class="alert alert-danger text-center mb-3" role="alert"
                     attrs="{'invisible': [('l10n_do_reported_606', '=', False), ('l10n_do_reported_607', '=', False)]}">
                    <strong>🔒 DOCUMENTO BLOQUEADO</strong>
                    <span class="ms-2">Reportado DGII período: <field name="l10n_do_report_period" readonly="1"/></span>
                </div>

                <!-- Banner Nota Débito -->
                <div class="alert alert-warning text-center mb-3" role="status"
                     attrs="{'invisible': [('l10n_do_is_debit_note', '=', False)]}">
                    <strong>📝 NOTA DE DÉBITO (B03)</strong>
                    <span class="ms-2">NCF Afectado: <field name="l10n_do_debit_ncf_origin" readonly="1"/></span>
                </div>

                <!-- Banner ND Proveedor -->
                <div class="alert alert-primary text-center mb-3" role="status"
                     attrs="{'invisible': [('l10n_do_is_vendor_debit_note', '=', False)]}">
                    <strong>📝 NOTA DE DÉBITO DE PROVEEDOR</strong>
                    <span class="ms-2">NCF Afectado: <field name="l10n_do_vendor_debit_ncf_origin" readonly="1"/></span>
                </div>
            </xpath>

            <!-- Campos fiscales después de partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <!-- Tipo NCF (Ventas) -->
                <field name="l10n_do_ncf_type_id" 
                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))],
                               'readonly': [('state', '=', 'posted')]}"
                       options="{'no_create': True}"/>

                <!-- Tipo Fiscal (Compras) -->
                <field name="l10n_do_fiscal_type" 
                       attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))],
                               'readonly': [('state', '=', 'posted')]}"/>
            </xpath>

            <!-- NCF Proveedor -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="l10n_do_vendor_ncf" 
                       attrs="{'invisible': ['|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('l10n_do_fiscal_type', 'in', ('informal', 'minor_expense'))],
                               'readonly': [('state', '=', 'posted')]}"
                       placeholder="B0100000001"/>
                <button name="action_validate_vendor_ncf" type="object" string="Validar NCF"
                        class="btn-link" 
                        attrs="{'invisible': ['|', '|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('l10n_do_vendor_ncf', '=', False), ('l10n_do_vendor_ncf_validated', '=', True)]}"/>
            </xpath>

            <!-- Notebook fiscal -->
            <xpath expr="//notebook" position="inside">

                <!-- TAB DATOS FISCALES VENTAS -->
                <page string="Datos Fiscales" name="fiscal_data" 
                      attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))]}">
                    
                    <group>
                        <group string="Comprobante">
                            <field name="l10n_do_ncf_number" readonly="1"/>
                            <field name="l10n_do_ncf_type_id" attrs="{'readonly': [('state', '=', 'posted')]}"/>
                            <field name="l10n_do_ncf_seq_id" readonly="1"/>
                            <field name="l10n_do_ncf_expiration" readonly="1"/>
                            <field name="l10n_do_ncf_required" attrs="{'readonly': [('state', '=', 'posted')]}"/>
                        </group>
                        <group string="Estado">
                            <field name="l10n_do_fiscal_status" readonly="1"/>
                            <field name="l10n_do_credited_amount" readonly="1"/>
                            <field name="l10n_do_reported_607" attrs="{'readonly': [('l10n_do_reported_607', '=', True)]}"/>
                            <field name="l10n_do_report_period" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Nota de Débito" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
                    <group attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}">
                        <group>
                            <field name="l10n_do_is_debit_note"/>
                            <field name="l10n_do_debit_note_reason" 
                                   attrs="{'invisible': [('l10n_do_is_debit_note', '=', False)],
                                           'required': [('l10n_do_is_debit_note', '=', True)]}"/>
                        </group>
                        <group>
                            <field name="l10n_do_debit_origin_move_id" 
                                   attrs="{'invisible': [('l10n_do_is_debit_note', '=', False)],
                                           'required': [('l10n_do_is_debit_note', '=', True)]}"/>
                            <field name="l10n_do_debit_ncf_origin" readonly="1" 
                                   attrs="{'invisible': [('l10n_do_is_debit_note', '=', False)]}"/>
                        </group>
                    </group>

                    <separator string="Nota de Crédito" attrs="{'invisible': [('move_type', '!=', 'out_refund')]}"/>
                    <group attrs="{'invisible': [('move_type', '!=', 'out_refund')]}">
                        <group>
                            <field name="l10n_do_credit_note_reason" 
                                   attrs="{'required': [('move_type', '=', 'out_refund')],
                                           'readonly': [('state', '=', 'posted')]}"/>
                        </group>
                        <group>
                            <field name="l10n_do_origin_move_id" attrs="{'readonly': [('state', '=', 'posted')]}"/>
                            <field name="l10n_do_ncf_origin" attrs="{'readonly': [('state', '=', 'posted')]}"/>
                        </group>
                    </group>

                    <separator string="Retención por Tercero (607)" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
                    <group attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}">
                        <group>
                            <field name="l10n_do_is_credit_sale"/>
                            <field name="l10n_do_retention_date" 
                                   attrs="{'invisible': [('l10n_do_is_credit_sale', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="l10n_do_third_party_retention_itbis" 
                                   attrs="{'invisible': [('l10n_do_is_credit_sale', '=', False)]}"/>
                            <field name="l10n_do_third_party_retention_isr" 
                                   attrs="{'invisible': [('l10n_do_is_credit_sale', '=', False)]}"/>
                            <field name="l10n_do_retention_reported" 
                                   attrs="{'invisible': [('l10n_do_is_credit_sale', '=', False)]}"/>
                        </group>
                    </group>

                    <separator string="Formas de Pago (607)"/>
                    <group>
                        <group>
                            <field name="l10n_do_payment_cash"/>
                            <field name="l10n_do_payment_bank"/>
                            <field name="l10n_do_payment_card"/>
                            <field name="l10n_do_payment_credit"/>
                        </group>
                        <group>
                            <field name="l10n_do_payment_bond"/>
                            <field name="l10n_do_payment_swap"/>
                            <field name="l10n_do_payment_other"/>
                            <field name="l10n_do_forma_pago" readonly="1"/>
                        </group>
                    </group>
                </page>

                <!-- TAB DATOS FISCALES COMPRAS -->
                <page string="Datos Fiscales (606)" name="fiscal_606" 
                      attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))]}">
                    
                    <group>
                        <group string="Clasificación">
                            <field name="l10n_do_fiscal_type"/>
                            <field name="l10n_do_purchase_type"/>
                            <field name="l10n_do_expense_type"/>
                        </group>
                        <group string="NCF">
                            <field name="l10n_do_vendor_ncf" 
                                   attrs="{'invisible': [('l10n_do_fiscal_type', 'in', ('informal', 'minor_expense'))]}"/>
                            <field name="l10n_do_ncf_number" readonly="1"
                                   attrs="{'invisible': [('l10n_do_fiscal_type', 'not in', ('informal', 'minor_expense'))]}"/>
                            <field name="l10n_do_reported_606" 
                                   attrs="{'readonly': [('l10n_do_reported_606', '=', True)]}"/>
                            <field name="l10n_do_report_period" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Proveedor Informal (B11)" 
                               attrs="{'invisible': [('l10n_do_fiscal_type', '!=', 'informal')]}"/>
                    <group attrs="{'invisible': [('l10n_do_fiscal_type', '!=', 'informal')]}">
                        <group>
                            <field name="l10n_do_informal_provider_name" 
                                   attrs="{'required': [('l10n_do_fiscal_type', '=', 'informal')]}"/>
                            <field name="l10n_do_informal_provider_cedula"/>
                            <field name="l10n_do_informal_rnc_verified" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_do_informal_service_type"/>
                            <button name="action_verify_informal_rnc" type="object" string="Verificar sin RNC"
                                    class="btn-secondary"/>
                        </group>
                    </group>

                    <separator string="Gasto Menor (B13)" 
                               attrs="{'invisible': [('l10n_do_fiscal_type', '!=', 'minor_expense')]}"/>
                    <group attrs="{'invisible': [('l10n_do_fiscal_type', '!=', 'minor_expense')]}">
                        <group>
                            <field name="l10n_do_minor_expense_type"/>
                            <field name="l10n_do_minor_expense_employee"/>
                        </group>
                        <group>
                            <field name="l10n_do_minor_expense_document"/>
                        </group>
                    </group>

                    <separator string="Pago al Exterior (B17)" 
                               attrs="{'invisible': [('l10n_do_fiscal_type', '!=', 'exterior')]}"/>
                    <group attrs="{'invisible': [('l10n_do_fiscal_type', '!=', 'exterior')]}">
                        <field name="l10n_do_exterior_service_type"/>
                    </group>

                    <separator string="Nota de Débito Proveedor" 
                               attrs="{'invisible': [('move_type', '!=', 'in_invoice')]}"/>
                    <group attrs="{'invisible': [('move_type', '!=', 'in_invoice')]}">
                        <group>
                            <field name="l10n_do_is_vendor_debit_note"/>
                        </group>
                        <group>
                            <field name="l10n_do_vendor_debit_ncf_origin" 
                                   attrs="{'invisible': [('l10n_do_is_vendor_debit_note', '=', False)],
                                           'required': [('l10n_do_is_vendor_debit_note', '=', True)]}"/>
                        </group>
                    </group>

                    <separator string="Clasificación Bienes/Servicios"/>
                    <group>
                        <group>
                            <field name="l10n_do_606_monto_bienes"/>
                            <field name="l10n_do_606_monto_servicios"/>
                        </group>
                    </group>

                    <separator string="ITBIS (606)"/>
                    <group>
                        <group>
                            <field name="l10n_do_itbis_facturado" readonly="1"/>
                            <field name="l10n_do_itbis_retenido" readonly="1"/>
                            <field name="l10n_do_itbis_percibido" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_do_itbis_proporcionalidad"/>
                            <field name="l10n_do_itbis_costo" 
                                   attrs="{'readonly': [('l10n_do_fiscal_type', '!=', 'minor_expense')]}"/>
                            <field name="l10n_do_itbis_adelantar" readonly="1"/>
                        </group>
                    </group>

                    <separator string="ISR (606)"/>
                    <group>
                        <group>
                            <field name="l10n_do_tipo_retencion_isr"/>
                            <field name="l10n_do_isr_retenido" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_do_isr_percibido" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Otros Impuestos y Propinas"/>
                    <group>
                        <group>
                            <field name="l10n_do_impuesto_selectivo"/>
                            <field name="l10n_do_otros_impuestos"/>
                        </group>
                        <group>
                            <field name="l10n_do_propina_legal"/>
                            <field name="l10n_do_forma_pago"/>
                        </group>
                    </group>

                    <separator string="Multimoneda" 
                               attrs="{'invisible': [('currency_id', '=', l10n_do_dop_currency_id)]}"/>
                    <group attrs="{'invisible': [('currency_id', '=', l10n_do_dop_currency_id)]}">
                        <group>
                            <field name="l10n_do_exchange_rate"/>
                            <field name="l10n_do_amount_dop" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_do_dop_currency_id" invisible="1"/>
                        </group>
                    </group>
                </page>

                <!-- TAB RETENCIONES -->
                <page string="Retenciones" name="retentions" 
                      attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))]}">
                    <group>
                        <group string="Retenciones Aplicadas">
                            <field name="l10n_do_total_isr_retention" readonly="1"/>
                            <field name="l10n_do_total_itbis_retention" readonly="1"/>
                        </group>
                        <group string="Monto a Pagar">
                            <field name="l10n_do_amount_to_pay" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <p class="text-muted">
                            Las retenciones se gestionan desde el botón "Agregar Retención" en la pestaña principal.
                        </p>
                    </group>
                </page>

            </xpath>

            <!-- Botones en header -->
            <xpath expr="//header" position="inside">
                <button name="action_mark_reported_606" type="object" string="Marcar 606"
                        class="btn-secondary"
                        attrs="{'invisible': ['|', '|', ('move_type', 'not in', ('in_invoice', 'in_refund')), ('l10n_do_reported_606', '=', True), ('state', '!=', 'posted')]}"/>
                <button name="action_mark_reported_607" type="object" string="Marcar 607"
                        class="btn-secondary"
                        attrs="{'invisible': ['|', '|', ('move_type', 'not in', ('out_invoice', 'out_refund')), ('l10n_do_reported_607', '=', True), ('state', '!=', 'posted')]}"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================= -->
    <!-- LISTA FACTURAS - COLUMNAS NCF                -->
    <!-- ============================================= -->

    <record id="view_in_invoice_tree_ncf" model="ir.ui.view">
        <field name="name">account.move.tree.vendor.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_do_vendor_ncf" string="NCF Proveedor" optional="show"/>
                <field name="l10n_do_fiscal_type" string="Tipo Fiscal" widget="badge" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- BÚSQUEDA                                      -->
    <!-- ============================================= -->

    <record id="view_account_move_filter_ncf" model="ir.ui.view">
        <field name="name">account.move.search.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='myinvoices']" position="after">
                <separator/>
                <filter name="has_ncf" string="Con NCF" domain="[('l10n_do_ncf_number', '!=', False)]"/>
                <filter name="without_ncf" string="Sin NCF" domain="[('l10n_do_ncf_number', '=', False), ('move_type', 'in', ('out_invoice', 'out_refund'))]"/>
                <separator/>
                <filter name="reported_606" string="Reportado 606" domain="[('l10n_do_reported_606', '=', True)]"/>
                <filter name="not_reported_606" string="Sin Reportar 606" domain="[('l10n_do_reported_606', '=', False), ('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted')]"/>
                <filter name="reported_607" string="Reportado 607" domain="[('l10n_do_reported_607', '=', True)]"/>
                <filter name="not_reported_607" string="Sin Reportar 607" domain="[('l10n_do_reported_607', '=', False), ('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted')]"/>
                <separator/>
                <filter name="fiscal_informal" string="B11 - Informal" domain="[('l10n_do_fiscal_type', '=', 'informal')]"/>
                <filter name="fiscal_minor" string="B13 - Gasto Menor" domain="[('l10n_do_fiscal_type', '=', 'minor_expense')]"/>
                <filter name="fiscal_exterior" string="B17 - Exterior" domain="[('l10n_do_fiscal_type', '=', 'exterior')]"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_do_ncf_number"/>
                <field name="l10n_do_vendor_ncf"/>
            </xpath>
        </field>
    </record>

</odoo>