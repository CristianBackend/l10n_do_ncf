<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================= -->
    <!-- FACTURA - PESTAÑAS DE DATOS FISCALES         -->
    <!-- ============================================= -->
    <!-- El banner de NCF, los campos de cabecera y la pestaña Retenciones
         están en view_move_form_ncf (report/invoice_report.xml). Esta vista
         tuvo ese mismo id y quedaba sobrescrita: no repetir aquí lo de allá. -->

    <record id="view_move_form_ncf_fiscal_data" model="ir.ui.view">
        <field name="name">account.move.form.ncf.fiscal.data</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Banners superiores -->
            <xpath expr="//sheet" position="before">
                <!-- Banner BLOQUEADO si reportado -->
                <div class="alert alert-danger text-center mb-3" role="alert"
                     invisible="not l10n_do_reported_606 and not l10n_do_reported_607">
                    <strong>🔒 DOCUMENTO BLOQUEADO</strong>
                    <span class="ms-2">Reportado DGII período: <field name="l10n_do_report_period" readonly="1"/></span>
                </div>

                <!-- Banner Nota Débito -->
                <div class="alert alert-warning text-center mb-3" role="status"
                     invisible="not l10n_do_is_debit_note">
                    <strong>📝 NOTA DE DÉBITO</strong>
                    <span class="ms-2">NCF Afectado: <field name="l10n_do_debit_ncf_origin" readonly="1" force_save="1"/></span>
                </div>

                <!-- Retenciones de la pestaña que no cuadran con el asiento -->
                <field name="l10n_do_retention_check" invisible="1"/>
                <div class="alert alert-warning mb-3" role="alert" invisible="not l10n_do_retention_check">
                    <div invisible="l10n_do_retention_check != 'no_entry'">
                        <strong>Retenciones sin asiento:
                            <field name="l10n_do_retention_gap" readonly="1" class="d-inline"/></strong>
                        <div>Las retenciones de la pestaña "Retenciones" no están en el asiento: no
                            reducen lo que se le debe al proveedor ni crean la deuda con la DGII, pero
                            sí salen en el 606, el IR-17 y el e-CF. Póngalas como impuesto de retención
                            en la línea (por ejemplo "-100% ITBIS" o "-15% ISR") y bórrelas de la pestaña.
                            Si la factura ya está confirmada, el contador debe registrar el ajuste.</div>
                    </div>
                    <div invisible="l10n_do_retention_check != 'mismatch'">
                        <strong>Las retenciones de la pestaña no coinciden con las del asiento
                            (diferencia <field name="l10n_do_retention_gap" readonly="1" class="d-inline"/>).</strong>
                        <div>El asiento retiene lo que dicen los impuestos de las líneas; el 606, el IR-17
                            y el e-CF usan lo de la pestaña "Retenciones". Deje las dos iguales; si la
                            factura ya está confirmada, el contador debe registrar el ajuste.</div>
                    </div>
                    <div invisible="l10n_do_retention_check != 'untyped'">
                        <strong>Impuesto de retención sin tipo DGII
                            (<field name="l10n_do_retention_gap" readonly="1" class="d-inline"/>).</strong>
                        <div>Está en el asiento pero no llega al 606 ni al IR-17. Complete "Tipo Retención
                            DGII" (ITBIS o ISR) en el impuesto.</div>
                        <button name="action_l10n_do_open_untyped_retention_taxes" type="object"
                                class="btn btn-sm btn-secondary mt-2" string="Abrir el impuesto"/>
                    </div>
                </div>

                <!-- Banner ND Proveedor -->
                <div class="alert alert-primary text-center mb-3" role="status"
                     invisible="not l10n_do_is_vendor_debit_note">
                    <strong>📝 NOTA DE DÉBITO DE PROVEEDOR</strong>
                    <span class="ms-2">NCF Afectado: <field name="l10n_do_vendor_debit_ncf_origin" readonly="1"/></span>
                </div>

            </xpath>

            <!-- Notebook fiscal -->
            <xpath expr="//notebook" position="inside">

                <!-- TAB DATOS FISCALES VENTAS -->
                <page string="Datos Fiscales" name="fiscal_data" 
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    
                    <group>
                        <group string="Comprobante">
                            <field name="l10n_do_ncf_number" readonly="1"/>
                            <field name="l10n_do_ncf_type_id" invisible="1"/>
                            <field name="l10n_do_ncf_type_display"/>
                            <field name="l10n_do_ncf_seq_id" readonly="1"/>
                            <field name="l10n_do_ncf_expiration" readonly="1"/>
                            <field name="l10n_do_ncf_required" readonly="state == 'posted'"/>
                        </group>
                        <group string="Estado">
                            <field name="l10n_do_fiscal_status" readonly="1"/>
                            <field name="l10n_do_credited_amount" readonly="1"/>
                            <field name="l10n_do_reported_607" readonly="l10n_do_reported_607"/>
                            <field name="l10n_do_report_period" readonly="1"/>
                            <field name="l10n_do_annulment_type" invisible="not l10n_do_annulment_type"/>
                            <field name="l10n_do_annulment_date" invisible="not l10n_do_annulment_date"/>
                        </group>
                        <group string="607">
                            <field name="l10n_do_ncf_is_electronic" invisible="1"/>
                            <!-- En un e-CF este dato se edita en "Comprobante electrónico". -->
                            <field name="l10n_do_ecf_income_type"
                                   invisible="move_type != 'out_invoice' or l10n_do_ncf_is_electronic"
                                   readonly="state == 'posted'"/>
                        </group>
                    </group>

                    <separator string="Nota de Débito" invisible="move_type != 'out_invoice'"/>
                    <group invisible="move_type != 'out_invoice'">
                        <group>
                            <!-- Una factura confirmada no se convierte en nota de
                                 débito: para eso está el botón "Nota de débito". -->
                            <field name="l10n_do_is_debit_note"
                                   readonly="state != 'draft' or l10n_do_ncf_number"/>
                            <field name="l10n_do_debit_note_reason"
                                   invisible="not l10n_do_is_debit_note"
                                   required="l10n_do_is_debit_note and state == 'draft'"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="commercial_partner_id" invisible="1"/>
                            <field name="l10n_do_debit_origin_move_id"
                                   invisible="not l10n_do_is_debit_note"
                                   required="l10n_do_is_debit_note and state == 'draft'"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"
                                   placeholder="Número o e-NCF de la factura"/>
                            <field name="l10n_do_debit_ncf_origin" readonly="1" force_save="1"
                                   invisible="not l10n_do_is_debit_note"/>
                        </group>
                    </group>

                    <separator string="Nota de Crédito" invisible="move_type != 'out_refund'"/>
                    <group invisible="move_type != 'out_refund'">
                        <group>
                            <!-- El motivo solo se exige mientras el documento
                                 es editable. Si se pide tambien en 'posted',
                                 el campo queda readonly y obligatorio a la vez,
                                 lo que bloquea guardar/imprimir la NC. -->
                            <field name="l10n_do_credit_note_reason" 
                                   required="move_type == 'out_refund' and l10n_do_ncf_required and state == 'draft'"
                                   readonly="state == 'posted'"/>
                        </group>
                        <group>
                            <field name="l10n_do_origin_move_id" readonly="state == 'posted'"/>
                            <field name="l10n_do_ncf_origin" readonly="state == 'posted'"/>
                        </group>
                    </group>

                    <separator string="Retención por Tercero (607)" invisible="move_type != 'out_invoice'"/>
                    <group invisible="move_type != 'out_invoice'">
                        <group>
                            <field name="l10n_do_is_credit_sale"/>
                            <field name="l10n_do_retention_date" 
                                   invisible="not l10n_do_is_credit_sale"/>
                        </group>
                        <group>
                            <field name="l10n_do_third_party_retention_itbis" 
                                   invisible="not l10n_do_is_credit_sale"/>
                            <field name="l10n_do_third_party_retention_isr" 
                                   invisible="not l10n_do_is_credit_sale"/>
                            <field name="l10n_do_retention_reported" 
                                   invisible="not l10n_do_is_credit_sale"/>
                        </group>
                    </group>

                    <separator string="Formas de Pago (607)"/>
                    <group>
                        <group>
                            <field name="l10n_do_payment_cash"/>
                            <field name="l10n_do_payment_bank"/>
                            <field name="l10n_do_payment_card"/>
                            <field name="l10n_do_payment_credit"/>
                        </group>
                        <group>
                            <field name="l10n_do_payment_bond"/>
                            <field name="l10n_do_payment_swap"/>
                            <field name="l10n_do_payment_other"/>
                            <field name="l10n_do_forma_pago" readonly="1"/>
                        </group>
                    </group>
                </page>

                <!-- TAB DATOS FISCALES COMPRAS -->
                <page string="Datos Fiscales (606)" name="fiscal_606" 
                      invisible="move_type not in ('in_invoice', 'in_refund')">
                    
                    <group>
                        <group string="Clasificación">
                            <field name="l10n_do_purchase_kind" readonly="1"
                                   invisible="l10n_do_is_vendor_debit_note"/>
                            <field name="l10n_do_purchase_type"/>
                            <field name="l10n_do_expense_type"/>
                        </group>
                        <group string="NCF">
                            <field name="l10n_do_vendor_ncf"
                                   invisible="l10n_do_purchase_kind != 'vendor'"/>
                            <field name="l10n_do_ncf_number" readonly="1"
                                   invisible="l10n_do_purchase_kind == 'vendor'"/>
                            <field name="l10n_do_reported_606" readonly="l10n_do_reported_606"/>
                            <field name="l10n_do_report_period" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Proveedor informal" 
                               invisible="l10n_do_fiscal_type != 'informal'"/>
                    <group invisible="l10n_do_fiscal_type != 'informal'">
                        <group>
                            <!-- Vacíos, se toman del contacto al confirmar. -->
                            <field name="l10n_do_informal_provider_name"
                                   placeholder="El nombre del contacto"/>
                            <field name="l10n_do_informal_provider_cedula"
                                   placeholder="La cédula del contacto"/>
                            <field name="l10n_do_informal_rnc_verified" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_do_informal_service_type"/>
                            <button name="action_verify_informal_rnc" type="object" string="Verificar sin RNC"
                                    class="btn-secondary"/>
                        </group>
                    </group>

                    <separator string="Gastos menores" 
                               invisible="l10n_do_fiscal_type != 'minor_expense'"/>
                    <group invisible="l10n_do_fiscal_type != 'minor_expense'">
                        <group>
                            <field name="l10n_do_minor_expense_type"/>
                            <field name="l10n_do_minor_expense_employee"/>
                        </group>
                        <group>
                            <field name="l10n_do_minor_expense_document"/>
                        </group>
                    </group>

                    <separator string="Pago al exterior" 
                               invisible="l10n_do_fiscal_type != 'exterior'"/>
                    <group invisible="l10n_do_fiscal_type != 'exterior'">
                        <group>
                            <field name="l10n_do_609_service_type"/>
                            <field name="l10n_do_609_service_detail"/>
                        </group>
                        <group>
                            <field name="l10n_do_exterior_service_type"
                                   invisible="not l10n_do_exterior_service_type"/>
                        </group>
                    </group>

                    <separator string="Nota de Débito Proveedor" 
                               invisible="move_type != 'in_invoice'"/>
                    <group invisible="move_type != 'in_invoice'">
                        <group>
                            <field name="l10n_do_is_vendor_debit_note"/>
                        </group>
                        <group>
                            <field name="l10n_do_vendor_debit_ncf_origin" 
                                   invisible="not l10n_do_is_vendor_debit_note"
                                   required="l10n_do_is_vendor_debit_note"/>
                        </group>
                    </group>

                    <separator string="Clasificación Bienes/Servicios"/>
                    <group>
                        <group>
                            <field name="l10n_do_606_monto_bienes"/>
                            <field name="l10n_do_606_monto_servicios"/>
                        </group>
                    </group>

                    <separator string="ITBIS (606)"/>
                    <group>
                        <group>
                            <field name="l10n_do_itbis_facturado" readonly="1"/>
                            <field name="l10n_do_itbis_retenido" readonly="1"/>
                            <field name="l10n_do_itbis_percibido" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_do_itbis_proporcionalidad"/>
                            <field name="l10n_do_itbis_costo" 
                                   readonly="l10n_do_fiscal_type != 'minor_expense'"/>
                            <field name="l10n_do_itbis_adelantar" readonly="1"/>
                        </group>
                    </group>

                    <separator string="ISR (606)"/>
                    <group>
                        <group>
                            <field name="l10n_do_tipo_retencion_isr"/>
                            <field name="l10n_do_isr_retenido" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_do_isr_percibido" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Otros Impuestos y Propinas"/>
                    <group>
                        <group>
                            <field name="l10n_do_impuesto_selectivo"/>
                            <field name="l10n_do_otros_impuestos"/>
                        </group>
                        <group>
                            <field name="l10n_do_propina_legal"/>
                            <field name="l10n_do_forma_pago"/>
                        </group>
                    </group>

                    <separator string="Multimoneda" 
                               invisible="currency_id == l10n_do_dop_currency_id"/>
                    <group invisible="currency_id == l10n_do_dop_currency_id">
                        <group>
                            <field name="l10n_do_exchange_rate"/>
                            <field name="l10n_do_amount_dop" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_do_dop_currency_id" invisible="1"/>
                        </group>
                    </group>
                </page>

            </xpath>

            <!-- Botones en header -->
            <xpath expr="//header" position="inside">
                <button name="action_mark_reported_606" type="object" string="Marcar 606"
                        class="btn-secondary"
                        invisible="move_type not in ('in_invoice', 'in_refund') or l10n_do_reported_606 or state != 'posted'"/>
                <button name="action_mark_reported_607" type="object" string="Marcar 607"
                        class="btn-secondary"
                        invisible="move_type not in ('out_invoice', 'out_refund') or l10n_do_reported_607 or state != 'posted'"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================= -->
    <!-- LISTA FACTURAS - COLUMNAS NCF                -->
    <!-- ============================================= -->
    <record id="view_out_invoice_tree_ncf" model="ir.ui.view">
        <field name="name">account.move.tree.customer.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_do_ncf_number" string="NCF" optional="show"/>
                <field name="l10n_do_ncf_type_id" string="Tipo NCF" optional="hide"/>
                <field name="l10n_do_fiscal_status" string="Estado Fiscal" widget="badge" optional="hide"
                       decoration-success="l10n_do_fiscal_status == 'valid'"
                       decoration-warning="l10n_do_fiscal_status == 'partial_credit'"
                       decoration-danger="l10n_do_fiscal_status in ('annulled', 'rejected')"/>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_tree_ncf" model="ir.ui.view">
        <field name="name">account.move.tree.vendor.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_do_vendor_ncf" string="NCF Proveedor" optional="show"/>
                <field name="l10n_do_purchase_kind" string="Tipo de compra" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Lista del Panel: retenciones sin asiento / que no coinciden -->
    <record id="view_move_tree_retention_check" model="ir.ui.view">
        <field name="name">account.move.list.retention.check</field>
        <field name="model">account.move</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="l10n_do_ncf_number" optional="show"/>
                <field name="l10n_do_vendor_ncf" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="l10n_do_total_itbis_retention" string="ITBIS retenido (reportes)" optional="show"/>
                <field name="l10n_do_total_isr_retention" string="ISR retenido (reportes)" optional="show"/>
                <field name="l10n_do_retention_check" widget="badge" decoration-warning="1"/>
                <field name="l10n_do_retention_gap" sum="Total por ajustar"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- BÚSQUEDA                                      -->
    <!-- ============================================= -->

    <record id="view_account_move_filter_ncf" model="ir.ui.view">
        <field name="name">account.move.search.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='myinvoices']" position="after">
                <separator/>
                <filter name="has_ncf" string="Con NCF" domain="[('l10n_do_ncf_number', '!=', False)]"/>
                <filter name="without_ncf" string="Sin NCF" domain="[('l10n_do_ncf_number', '=', False), ('move_type', 'in', ('out_invoice', 'out_refund'))]"/>
                <separator/>
                <filter name="reported_606" string="Reportado 606" domain="[('l10n_do_reported_606', '=', True)]"/>
                <filter name="not_reported_606" string="Sin Reportar 606" domain="[('l10n_do_reported_606', '=', False), ('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted')]"/>
                <filter name="reported_607" string="Reportado 607" domain="[('l10n_do_reported_607', '=', True)]"/>
                <filter name="not_reported_607" string="Sin Reportar 607" domain="[('l10n_do_reported_607', '=', False), ('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted')]"/>
                <separator/>
                <filter name="fiscal_informal" string="Proveedor informal" domain="[('l10n_do_fiscal_type', '=', 'informal')]"/>
                <filter name="fiscal_minor" string="Gastos menores" domain="[('l10n_do_fiscal_type', '=', 'minor_expense')]"/>
                <filter name="fiscal_exterior" string="Pago al exterior" domain="[('l10n_do_fiscal_type', '=', 'exterior')]"/>
                <filter name="retention_check" string="Retenciones por revisar" domain="[('l10n_do_retention_check', '!=', False)]"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_do_ncf_number"/>
                <field name="l10n_do_vendor_ncf"/>
            </xpath>
        </field>
    </record>
    <!-- ============================================= -->
    <!-- OCULTAR RIBBON "PAGADO" EN NOTAS DE CRÉDITO  -->
    <!-- ============================================= -->

    <!-- ============================================= -->
    <!-- RIBBON "APLICADA" PARA NOTAS DE CRÉDITO      -->
    <!-- ============================================= -->
    <record id="view_move_form_nc_ribbon" model="ir.ui.view">
        <field name="name">account.move.form.nc.ribbon</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Aplicada"
                        bg_color="text-bg-info"
                        invisible="payment_state != 'paid' or move_type not in ('out_refund', 'in_refund')"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- LISTA: MOSTRAR "APLICADA" EN NC              -->
    <!-- ============================================= -->
    <record id="view_invoice_tree_payment_status" model="ir.ui.view">
        <field name="name">account.move.tree.payment.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="l10n_do_payment_status_display" string="Estado" 
                       widget="badge"
                       decoration-success="payment_state in ('paid', 'in_payment', 'reversed')"
                       decoration-warning="payment_state == 'partial'"
                       decoration-info="state == 'draft'"
                       decoration-danger="payment_state == 'not_paid'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>