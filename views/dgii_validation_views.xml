<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================= -->
    <!-- VALIDACIÓN DGII - FORMULARIO                 -->
    <!-- ============================================= -->
    
    <record id="view_dgii_validation_form" model="ir.ui.view">
        <field name="name">l10n_do_ncf.dgii.validation.form</field>
        <field name="model">l10n_do_ncf.dgii.validation</field>
        <field name="arch" type="xml">
            <form string="Validación DGII" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Datos Validados">
                            <field name="validation_type"/>
                            <field name="rnc" invisible="validation_type != 'rnc'"/>
                            <field name="ncf" invisible="validation_type != 'ncf'"/>
                            <field name="vendor_rnc" invisible="validation_type != 'ncf'"/>
                            <field name="is_valid" widget="boolean_toggle"/>
                        </group>
                        <group string="Resultado">
                            <field name="business_name"/>
                            <field name="trade_name"/>
                            <field name="status"/>
                            <field name="activity"/>
                        </group>
                    </group>

                    <group invisible="validation_type != 'ncf'">
                        <group string="Datos NCF">
                            <field name="ncf_type"/>
                            <field name="ncf_status"/>
                            <field name="authorization_date"/>
                            <field name="expiration_date"/>
                        </group>
                    </group>

                    <group>
                        <group string="Metadata">
                            <field name="validation_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="error_message" invisible="not error_message"/>
                        </group>
                        <group string="Documento Relacionado">
                            <field name="move_id"/>
                            <field name="registro_unico_id"/>
                        </group>
                    </group>

                    <group string="Respuesta Raw" invisible="not response_raw">
                        <field name="response_raw" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- VALIDACIÓN DGII - LISTA                      -->
    <!-- ============================================= -->

    <record id="view_dgii_validation_tree" model="ir.ui.view">
        <field name="name">l10n_do_ncf.dgii.validation.tree</field>
        <field name="model">l10n_do_ncf.dgii.validation</field>
        <field name="arch" type="xml">
            <list string="Validaciones DGII" create="false" edit="false"
                  decoration-success="is_valid == True" decoration-danger="is_valid == False">
                <field name="validation_date"/>
                <field name="validation_type" widget="badge"/>
                <field name="rnc"/>
                <field name="ncf"/>
                <field name="business_name"/>
                <field name="status"/>
                <field name="is_valid" widget="boolean"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- VALIDACIÓN DGII - BÚSQUEDA                   -->
    <!-- ============================================= -->

    <record id="view_dgii_validation_search" model="ir.ui.view">
        <field name="name">l10n_do_ncf.dgii.validation.search</field>
        <field name="model">l10n_do_ncf.dgii.validation</field>
        <field name="arch" type="xml">
            <search string="Buscar Validaciones">
                <field name="rnc"/>
                <field name="ncf"/>
                <field name="business_name"/>
                <separator/>
                <filter name="rnc_type" string="RNC" domain="[('validation_type', '=', 'rnc')]"/>
                <filter name="ncf_type" string="NCF" domain="[('validation_type', '=', 'ncf')]"/>
                <separator/>
                <filter name="valid" string="Válidos" domain="[('is_valid', '=', True)]"/>
                <filter name="invalid" string="Inválidos" domain="[('is_valid', '=', False)]"/>
                <separator/>
                <filter name="today" string="Hoy" domain="[('validation_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter name="last_24h" string="Últimas 24h" domain="[('validation_date', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <group string="Agrupar por">
                    <filter name="group_type" string="Tipo" context="{'group_by': 'validation_type'}"/>
                    <filter name="group_valid" string="Válido" context="{'group_by': 'is_valid'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'validation_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- ACCIÓN VALIDACIONES                          -->
    <!-- ============================================= -->

    <record id="action_dgii_validation" model="ir.actions.act_window">
        <field name="name">Cache Validaciones DGII</field>
        <field name="res_model">l10n_do_ncf.dgii.validation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay validaciones en cache
            </p>
            <p>
                Las validaciones de RNC y NCF se almacenan aquí por 24 horas
                para evitar consultas repetidas a DGII.
            </p>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- TASA BC - FORMULARIO                         -->
    <!-- ============================================= -->

    <record id="view_bc_exchange_rate_form" model="ir.ui.view">
        <field name="name">l10n_do_ncf.bc.exchange.rate.form</field>
        <field name="model">l10n_do_ncf.bc.exchange.rate</field>
        <field name="arch" type="xml">
            <form string="Tasa de Cambio BC">
                <sheet>
                    <group>
                        <group string="Fecha y Moneda">
                            <field name="date"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Tasas">
                            <field name="rate_buy"/>
                            <field name="rate_sell"/>
                            <field name="rate_average" readonly="1"/>
                            <field name="source"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- TASA BC - LISTA                              -->
    <!-- ============================================= -->

    <record id="view_bc_exchange_rate_tree" model="ir.ui.view">
        <field name="name">l10n_do_ncf.bc.exchange.rate.tree</field>
        <field name="model">l10n_do_ncf.bc.exchange.rate</field>
        <field name="arch" type="xml">
            <list string="Tasas de Cambio BC" editable="bottom">
                <field name="date"/>
                <field name="currency_id"/>
                <field name="rate_buy"/>
                <field name="rate_sell"/>
                <field name="rate_average" readonly="1"/>
                <field name="source" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- TASA BC - BÚSQUEDA                           -->
    <!-- ============================================= -->

    <record id="view_bc_exchange_rate_search" model="ir.ui.view">
        <field name="name">l10n_do_ncf.bc.exchange.rate.search</field>
        <field name="model">l10n_do_ncf.bc.exchange.rate</field>
        <field name="arch" type="xml">
            <search string="Buscar Tasas">
                <field name="date"/>
                <field name="currency_id"/>
                <separator/>
                <filter name="this_month" string="Este Mes" domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_month" string="Mes Anterior" domain="[('date', '&gt;=', (context_today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')), ('date', '&lt;', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="bc_api" string="API BC" domain="[('source', '=', 'bc_api')]"/>
                <filter name="manual" string="Manual" domain="[('source', '=', 'manual')]"/>
                <group string="Agrupar por">
                    <filter name="group_month" string="Mes" context="{'group_by': 'date:month'}"/>
                    <filter name="group_currency" string="Moneda" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- ACCIÓN TASAS BC                              -->
    <!-- ============================================= -->

    <record id="action_bc_exchange_rate" model="ir.actions.act_window">
        <field name="name">Tasas Banco Central</field>
        <field name="res_model">l10n_do_ncf.bc.exchange.rate</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Agregar tasa de cambio
            </p>
            <p>
                Las tasas del Banco Central se usan para convertir
                facturas en moneda extranjera a DOP para reportes DGII.
            </p>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- AUDITORÍA FISCAL - LISTA                     -->
    <!-- ============================================= -->

    <record id="view_fiscal_audit_tree" model="ir.ui.view">
        <field name="name">l10n_do_ncf.fiscal.audit.tree</field>
        <field name="model">l10n_do_ncf.fiscal.audit</field>
        <field name="arch" type="xml">
            <list string="Auditoría Fiscal" create="false" edit="false"
                  decoration-info="event_type == 'ncf_generated'"
                  decoration-danger="event_type in ('ncf_annulled', 'validation_error', 'dgii_rejection')"
                  decoration-success="event_type == 'dgii_accepted'">
                <field name="create_date" string="Fecha/Hora"/>
                <field name="event_type" widget="badge"/>
                <field name="ncf_number"/>
                <field name="ncf_type"/>
                <field name="description"/>
                <field name="user_id"/>
                <field name="move_id" optional="show"/>
                <field name="old_value" optional="hide"/>
                <field name="new_value" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- AUDITORÍA FISCAL - FORMULARIO                -->
    <!-- ============================================= -->

    <record id="view_fiscal_audit_form" model="ir.ui.view">
        <field name="name">l10n_do_ncf.fiscal.audit.form</field>
        <field name="model">l10n_do_ncf.fiscal.audit</field>
        <field name="arch" type="xml">
            <form string="Detalle Auditoría" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Evento">
                            <field name="event_type"/>
                            <field name="ncf_number"/>
                            <field name="ncf_type"/>
                            <field name="ncf_origin"/>
                        </group>
                        <group string="Documento">
                            <field name="move_id"/>
                            <field name="registro_unico_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cambios">
                            <field name="old_value"/>
                            <field name="new_value"/>
                        </group>
                        <group string="Usuario">
                            <field name="user_id"/>
                            <field name="create_date"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Datos Adicionales" invisible="not extra_data">
                        <field name="extra_data" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- AUDITORÍA FISCAL - BÚSQUEDA                  -->
    <!-- ============================================= -->

    <record id="view_fiscal_audit_search" model="ir.ui.view">
        <field name="name">l10n_do_ncf.fiscal.audit.search</field>
        <field name="model">l10n_do_ncf.fiscal.audit</field>
        <field name="arch" type="xml">
            <search string="Buscar Auditoría">
                <field name="ncf_number"/>
                <field name="move_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="generated" string="NCF Generados" domain="[('event_type', '=', 'ncf_generated')]"/>
                <filter name="annulled" string="Anulados" domain="[('event_type', '=', 'ncf_annulled')]"/>
                <filter name="status_change" string="Cambios Estado" domain="[('event_type', '=', 'status_change')]"/>
                <filter name="errors" string="Errores" domain="[('event_type', 'in', ('validation_error', 'dgii_rejection'))]"/>
                <separator/>
                <filter name="today" string="Hoy" domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter name="this_week" string="Esta Semana" domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group string="Agrupar por">
                    <filter name="group_type" string="Tipo Evento" context="{'group_by': 'event_type'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- ACCIÓN AUDITORÍA                             -->
    <!-- ============================================= -->

    <record id="action_fiscal_audit" model="ir.actions.act_window">
        <field name="name">Auditoría Fiscal</field>
        <field name="res_model">l10n_do_ncf.fiscal.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay registros de auditoría
            </p>
            <p>
                Aquí se registran todos los eventos relacionados con NCF:
                generación, anulación, cambios de estado, errores, etc.
            </p>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- MENÚS                                        -->
    <!-- ============================================= -->

    <!-- Submenú DGII en Contabilidad -->
    <menuitem id="menu_dgii_tools"
              name="Herramientas DGII"
              parent="account.menu_finance_configuration"
              sequence="100"/>

    <menuitem id="menu_dgii_validation"
              name="Cache Validaciones"
              parent="menu_dgii_tools"
              action="action_dgii_validation"
              sequence="10"/>

    <menuitem id="menu_bc_exchange_rate"
              name="Tasas Banco Central"
              parent="menu_dgii_tools"
              action="action_bc_exchange_rate"
              sequence="20"/>

    <menuitem id="menu_fiscal_audit"
              name="Auditoría Fiscal"
              parent="menu_dgii_tools"
              action="action_fiscal_audit"
              sequence="30"/>

    <!-- ============================================= -->
    <!-- EXTENSIÓN RES.PARTNER - BOTÓN VALIDAR        -->
    <!-- ============================================= -->

    <record id="view_partner_form_dgii" model="ir.ui.view">
        <field name="name">res.partner.form.dgii.validation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_do_dgii_validated" invisible="1"/>
                <button name="action_validate_dgii" type="object"
                        string="🔍 Validar DGII" class="btn-link"
                        invisible="not vat"/>
                <span class="badge bg-success ms-2" invisible="not l10n_do_dgii_validated">✓ Validado</span>
                <field name="l10n_do_dgii_status" readonly="1" invisible="not l10n_do_dgii_validated"/>
            </xpath>
        </field>
    </record>

</odoo>