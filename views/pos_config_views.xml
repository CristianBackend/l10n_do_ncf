<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================= -->
    <!-- CONFIGURACIÓN NCF EN PUNTO DE VENTA          -->
    <!-- Agrega campos NCF en la configuración POS    -->
    <!-- Odoo 19 Compatible                           -->
    <!-- ============================================= -->

    <record id="view_pos_config_form_ncf" model="ir.ui.view">
        <field name="name">pos.config.form.ncf</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Agregar campos NCF al final del formulario -->
            <xpath expr="//sheet" position="inside">
                <group string="NCF - Comprobantes Fiscales" name="ncf_config">
                    <group>
                        <field name="l10n_do_ncf_enabled"/>
                        <field name="l10n_do_pos_default_partner_id"
                               options="{'no_create': True}"
                               placeholder="Ej: Cliente al Contado"/>
                    </group>
                </group>
                
                <group string="Secuencias NCF" invisible="not l10n_do_ncf_enabled">
                    <group>
                        <field name="l10n_do_ncf_sequence_id" 
                               placeholder="Seleccionar secuencia B02..."
                               options="{'no_create': True}"/>
                        <field name="l10n_do_ncf_fiscal_sequence_id" 
                               placeholder="Seleccionar secuencia B01..."
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="l10n_do_ncf_special_sequence_id" 
                               placeholder="Seleccionar secuencia B14..."
                               options="{'no_create': True}"/>
                        <field name="l10n_do_ncf_gov_sequence_id" 
                               placeholder="Seleccionar secuencia B15..."
                               options="{'no_create': True}"/>
                    </group>
                </group>

                <div class="alert alert-info" role="status" invisible="not l10n_do_ncf_enabled">
                    <strong>Información:</strong>
                    <ul class="mb-0 mt-2">
                        <li>El NCF se genera automáticamente al confirmar el pago</li>
                        <li>Sin cliente = Consumidor Final (B02)</li>
                        <li>Contribuyente con RNC = Crédito Fiscal (B01)</li>
                    </ul>
                </div>
            </xpath>
        </field>
    </record>

</odoo>