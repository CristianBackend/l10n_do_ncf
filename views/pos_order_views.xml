<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================= -->
    <!-- VISTAS DE ÓRDENES POS CON NCF                -->
    <!-- Odoo 19 Compatible                           -->
    <!-- ============================================= -->

    <!-- Vista de lista: agregar columna NCF -->
    <record id="view_pos_order_list_ncf" model="ir.ui.view">
        <field name="name">pos.order.list.ncf</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_do_ncf_number" string="NCF" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de formulario: agregar sección NCF -->
    <record id="view_pos_order_form_ncf" model="ir.ui.view">
        <field name="name">pos.order.form.ncf</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Información Fiscal (NCF)" invisible="not l10n_do_ncf_number">
                    <group>
                        <field name="l10n_do_ncf_number" readonly="1"/>
                        <field name="l10n_do_ncf_type" readonly="1"/>
                    </group>
                    <group>
                        <field name="l10n_do_partner_vat" string="RNC/Cédula" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>